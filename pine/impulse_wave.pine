//@version=6

indicator("impulse_wave", "Impulse 1-5", overlay = true,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

gZ = "① ZigZag（ATR 反转阈值）"
tfAuto = input.bool(true, "阈值按周期自动缩放（推荐）", group = gZ,
     tooltip = "**打开之后下面三个手动值不生效。**\n\n" +
               "阈值是 ATR 倍数，幅度上跨周期自适应，但**枢轴数量不会** —— 枢轴数取决于" +
               "图上有多少根K线。实测 ETH：日线 1713 根，ATR×2/×4/×8 给出 114/42/15 个枢轴；" +
               "周线只有 246 根，同样的倍数只给出 14/7/**3** 个。\n\n" +
               "自动模式按图表周期选：\n" +
               "  月线      0.25 / 0.5 / 0.75\n" +
               "  周线      0.5  / 1.0 / 1.5\n" +
               "  日线·4h   2    / 4   / 8\n" +
               "  4h 以下   3    / 6   / 12\n\n" +
               "状态表第二列显示的是**实际生效**的倍数。")
atrLen = input.int(14, "ATR 周期", minval = 1, group = gZ)
mA = input.float(2.0, "手动：级别「细」阈值 = ATR ×", minval = 0.1, step = 0.1, group = gZ)
mB = input.float(4.0, "手动：级别「中」阈值 = ATR ×", minval = 0.1, step = 0.1, group = gZ)
mC = input.float(8.0, "手动：级别「粗」阈值 = ATR ×", minval = 0.1, step = 0.1, group = gZ)
onA = input.bool(true,  "启用级别「细」", group = gZ)
onB = input.bool(true,  "启用级别「中」", group = gZ)
onC = input.bool(false, "启用级别「粗」", group = gZ,
     tooltip = "级别原来叫 A / B / C，现在改叫 细 / 中 / 粗 —— 因为推演会画出调整浪 A、B、C，" +
               "「B 级别的 A 浪」这种标签没法读。")

tfSec = timeframe.in_seconds()
autoA = tfSec >= 2592000 ? 0.25 : tfSec >= 604800 ? 0.5 : tfSec >= 14400 ? 2.0 : 3.0
autoB = tfSec >= 2592000 ? 0.50 : tfSec >= 604800 ? 1.0 : tfSec >= 14400 ? 4.0 : 6.0
autoC = tfSec >= 2592000 ? 0.75 : tfSec >= 604800 ? 1.5 : tfSec >= 14400 ? 8.0 : 12.0
useA = tfAuto ? autoA : mA
useB = tfAuto ? autoB : mB
useC = tfAuto ? autoC : mC

gR = "② 校验规则"
need5 = input.bool(true, "浪5 必须超越浪3 端点", group = gR,
     tooltip = "关掉 = 允许衰竭浪（truncated fifth）。三条硬规则之外加的第四条，" +
               "衰竭浪在艾略特里合法但少见，默认打开能少掉很多噪声数浪。")
ovTol = input.float(0.0, "浪4 允许重叠浪1 的比例", minval = 0.0, maxval = 0.5, step = 0.01, group = gR,
     tooltip = "「浪4 不进浪1 价格区间」是艾略特最硬的一条，默认 0 = 一点都不让。" +
               "对角线形态（leading / ending diagonal）允许重叠，所以给一个容差，" +
               "单位是浪1 长度的比例。**调这个值是在放宽定义，不是在改进检测。**")
fibOn = input.bool(true,  "浪3 ≥ N×浪1 时加粗标 ★（仅加分）", group = gR)
fibN  = input.float(1.618, "加分比例 N", minval = 0.5, step = 0.1, group = gR)
maxPat = input.int(1, "每个级别保留最近几组", minval = 1, maxval = 8, group = gR)
maxSpan = input.int(300, "一组浪最大跨度（根，0 = 不限）", minval = 0, group = gR,
     tooltip = "浪线是两个枢轴之间的直线；枢轴隔了几百根的时候两端都在屏幕外，" +
               "中间那条直线会横穿图表、落在和当地K线无关的价位上。")

gP = "③ 场景推演"
showProj = input.bool(true, "画场景推演", group = gP,
     tooltip = "判断**现在**处在艾略特周期 1-2-3-4-5-A-B-C 的哪一浪，从现在往后画几段。\n\n" +
               "八个位置逐一检验，取能解释最多枢轴的那个；一个都不成立时，退回到" +
               "「新的一浪1 正在走」—— 所以只要图上有 2 个以上枢轴，就一定画得出来。\n\n" +
               "**每根都会重算。这是规则的机械推论，不是信号。**")
projLegs = input.int(4, "往后推几段", minval = 1, maxval = 6, group = gP)
ret2 = input.float(0.618, "高度 · 浪2 回撤浪1", minval = 0.1, maxval = 0.99, step = 0.01, group = gP)
fib3 = input.float(1.618, "高度 · 浪3 = 浪1 ×", minval = 1.0, maxval = 4.236, step = 0.1, group = gP)
ret4 = input.float(0.382, "高度 · 浪4 回撤浪3", minval = 0.1, maxval = 0.9, step = 0.01, group = gP)
fib5 = input.float(1.0, "高度 · 浪5 = 浪1 ×", minval = 0.382, maxval = 3.0, step = 0.1, group = gP,
     tooltip = "浪3 延长时，「浪5 = 浪1」可能连浪3 的高点都过不去；这时自动改用另一条常用指引：" +
               "浪5 = 0.618 × (浪1 起点 → 浪3 终点)。")
projRetr = input.float(0.5, "高度 · ABC 合计回撤推动浪", minval = 0.1, maxval = 1.0, step = 0.05, group = gP,
     tooltip = "C 的终点 = 浪5 终点回撤 (1-5 全长) × 这个比例。\n" +
               "A、B、C 的分配按最常见的锯齿形：B 回撤 A 下面那个比例，C = A。")
retB = input.float(0.618, "高度 · B 回撤 A", minval = 0.1, maxval = 0.99, step = 0.01, group = gP)
projRay = input.bool(true, "在推演终点价画水平射线", group = gP,
     tooltip = "从推演终点往右延伸。旧版从当前K线画起，终点价离现价远时（比如 +52%）" +
               "会把整张图的纵轴撑开、K线被压扁；现在从终点画起，不影响当前视图。")

gS = "④ 样式"
cA = input.color(#42a5f5, "级别「细」颜色", group = gS, inline = "A")
wA = input.int(2, "线宽", minval = 1, maxval = 6, group = gS, inline = "A")
cB = input.color(#ab47bc, "级别「中」颜色", group = gS, inline = "B")
wB = input.int(2, "线宽", minval = 1, maxval = 6, group = gS, inline = "B")
cC = input.color(#ffa726, "级别「粗」颜色", group = gS, inline = "C")
wC = input.int(2, "线宽", minval = 1, maxval = 6, group = gS, inline = "C")
starW   = input.int(2, "浪3 达标时额外加粗", minval = 0, maxval = 4, group = gS)
lblSize = input.string("tiny", "图上标签大小", options = ["tiny", "small", "normal"], group = gS)
projLbl = input.string("浪名", "推演标签内容", options = ["浪名", "浪名 + 价位 + %"], group = gS,
     tooltip = "默认只写浪名（A、(3) 这样），不挡K线。**鼠标移到图上任何一个标签上**，会弹出正常字号的详情：\n" +
               "  推演点：终点价、离现价多少 %、大约几根后到（估算日期）、" +
               "这个价位怎么算出来的（高度依据）、这一段的斜率和同类腿的实测速度（角度依据）\n" +
               "  已确认的 (1)..(5)：这一浪涨跌多少、走了几根、和浪1 的比例\n\n" +
               "Pine 指标没法响应鼠标点击，悬停浮窗是最接近「点一下放大」的原生功能。")
pWidth  = input.int(2, "推演线 线宽", minval = 1, maxval = 6, group = gS, inline = "P")
pStyle  = input.string("虚线", "样式", options = ["虚线", "点线", "实线"], group = gS, inline = "P")
showZZ  = input.bool(false, "画出 ZigZag 骨架（调阈值时打开）", group = gS, inline = "Z")
zzW     = input.int(1, "线宽", minval = 1, maxval = 4, group = gS, inline = "Z")
zzT     = input.int(55, "透明度", minval = 0, maxval = 100, group = gS, inline = "Z")
showTbl = input.bool(true, "右下角状态表", group = gS, inline = "TB")
tblSz   = input.string("极小", "字号", options = ["极小", "小", "中", "大"], group = gS, inline = "TB",
     tooltip = "默认极小，不占图。**鼠标移到状态表任意一行上，会弹出这一行的完整明细**" +
               "（正常字号）：当前位置、推演路径每一段的价位 / 涨跌幅 / 大约几根后到、腿的速度。\n\n" +
               "Pine 指标没法响应鼠标点击，所以做不成「点一下放大」；悬停浮窗是最接近的原生功能。")
tblPos  = input.string("右下", "状态表位置", options = ["右下", "右中", "右上", "左下", "左中", "左上", "中下", "中上"],
     group = gS, tooltip = "Pine 的表格只能放在固定位置，没法用鼠标拖动。在这里选。")
detailMode = input.string("悬停浮窗（电脑）", "详情显示方式", options = ["悬停浮窗（电脑）", "直接显示（手机）"],
     group = gS,
     tooltip = "悬停浮窗：图上干净，鼠标移到标签 / 状态表上才弹出详情。**手机上没有悬停，用不了。**\n\n" +
               "直接显示：推演标签写全（浪名 + 价位 + %），状态表下方多出一块明细，" +
               "列出下面那个级别推演路径的每一个点：价位、离现价、约几根后和日期、依据。不用悬停。\n\n" +
               "注意：指标设置跟着图表布局走，会在电脑和手机之间同步。")
detailLv = input.string("细", "直接显示时列出哪个级别", options = ["细", "中", "粗"], group = gS)

atrRaw = ta.atr(atrLen)
atrOk  = not na(atrRaw)
atrV   = nz(atrRaw, syminfo.mintick * 10.0)

szLbl = lblSize == "normal" ? size.normal : lblSize == "small" ? size.small : size.tiny
szT   = tblSz == "大" ? size.large : tblSz == "中" ? size.normal : tblSz == "小" ? size.small : size.tiny
posT  = tblPos == "右上" ? position.top_right : tblPos == "右中" ? position.middle_right : tblPos == "左下" ? position.bottom_left : tblPos == "左中" ? position.middle_left : tblPos == "左上" ? position.top_left : tblPos == "中下" ? position.bottom_center : tblPos == "中上" ? position.top_center : position.bottom_right
direct = detailMode == "直接显示（手机）"
stPrj = pStyle == "实线" ? line.style_solid : pStyle == "点线" ? line.style_dotted : line.style_dashed

type Piv
    float price
    int   bi
    bool  isHigh

type Wave
    array<line>  segs
    array<label> lbs
    bool  bull
    float p5px
    float tgtPx
    bool  expired

type Lv
    string       name
    float        mult
    color        col
    int          wid
    bool         on
    int          dir
    float        ext
    int          extBi
    float        ext2
    int          ext2Bi
    array<Piv>   pv
    array<Wave>  ws
    array<line>  zz
    int          hits
    int          lastDir
    int          pvTotal
    array<line>  sL
    array<label> sB
    line         sRay
    int          sK
    int          sP0
    string       note
    string       note2
    string       tip
    array<string> dCells

var Lv LA = Lv.new(name = "细", mult = useA, col = cA, wid = wA, on = onA, dir = 0,
     ext = na, extBi = na, ext2 = na, ext2Bi = na,
     pv = array.new<Piv>(), ws = array.new<Wave>(), zz = array.new<line>(),
     hits = 0, lastDir = 0, pvTotal = 0,
     sL = array.new<line>(), sB = array.new<label>(), sK = -1, sP0 = -1, note = "", note2 = "", tip = "",
     dCells = array.new<string>())
var Lv LB = Lv.new(name = "中", mult = useB, col = cB, wid = wB, on = onB, dir = 0,
     ext = na, extBi = na, ext2 = na, ext2Bi = na,
     pv = array.new<Piv>(), ws = array.new<Wave>(), zz = array.new<line>(),
     hits = 0, lastDir = 0, pvTotal = 0,
     sL = array.new<line>(), sB = array.new<label>(), sK = -1, sP0 = -1, note = "", note2 = "", tip = "",
     dCells = array.new<string>())
var Lv LC = Lv.new(name = "粗", mult = useC, col = cC, wid = wC, on = onC, dir = 0,
     ext = na, extBi = na, ext2 = na, ext2Bi = na,
     pv = array.new<Piv>(), ws = array.new<Wave>(), zz = array.new<line>(),
     hits = 0, lastDir = 0, pvTotal = 0,
     sL = array.new<line>(), sB = array.new<label>(), sK = -1, sP0 = -1, note = "", note2 = "", tip = "",
     dCells = array.new<string>())

method zigzag(Lv L, float thr) =>
    bool confirmed = false

    if L.dir == 0
        if na(L.ext)
            L.ext    := high
            L.extBi  := bar_index
            L.ext2   := low
            L.ext2Bi := bar_index
        else
            if high > L.ext
                L.ext   := high
                L.extBi := bar_index
            if low < L.ext2
                L.ext2   := low
                L.ext2Bi := bar_index
            if close < L.ext - thr
                array.push(L.pv, Piv.new(L.ext, L.extBi, true))
                confirmed := true
                L.dir   := -1
                L.ext   := low
                L.extBi := bar_index
            else if close > L.ext2 + thr
                array.push(L.pv, Piv.new(L.ext2, L.ext2Bi, false))
                confirmed := true
                L.dir   := 1
                L.ext   := high
                L.extBi := bar_index
    else if L.dir == 1
        if high > L.ext
            L.ext   := high
            L.extBi := bar_index
        if close < L.ext - thr
            array.push(L.pv, Piv.new(L.ext, L.extBi, true))
            confirmed := true
            L.dir   := -1
            L.ext   := low
            L.extBi := bar_index
    else
        if low < L.ext
            L.ext   := low
            L.extBi := bar_index
        if close > L.ext + thr
            array.push(L.pv, Piv.new(L.ext, L.extBi, false))
            confirmed := true
            L.dir   := 1
            L.ext   := high
            L.extBi := bar_index

    if confirmed
        L.pvTotal := L.pvTotal + 1
    if array.size(L.pv) > 24
        array.shift(L.pv)

    if confirmed and showZZ and array.size(L.pv) >= 2
        Piv q0 = array.get(L.pv, array.size(L.pv) - 2)
        Piv q1 = array.get(L.pv, array.size(L.pv) - 1)
        array.push(L.zz, line.new(q0.bi, q0.price, q1.bi, q1.price, xloc = xloc.bar_index,
             color = color.new(L.col, zzT), width = zzW))
        if array.size(L.zz) > 40
            line.delete(array.shift(L.zz))
    confirmed

delWave(Wave w) =>
    if array.size(w.segs) > 0
        for i = 0 to array.size(w.segs) - 1
            line.delete(array.get(w.segs, i))
    if array.size(w.lbs) > 0
        for i = 0 to array.size(w.lbs) - 1
            label.delete(array.get(w.lbs, i))

method detect(Lv L) =>
    bool found = false
    int n = array.size(L.pv)
    if n >= 6
        Piv p0 = array.get(L.pv, n - 6)
        Piv p1 = array.get(L.pv, n - 5)
        Piv p2 = array.get(L.pv, n - 4)
        Piv p3 = array.get(L.pv, n - 3)
        Piv p4 = array.get(L.pv, n - 2)
        Piv p5 = array.get(L.pv, n - 1)

        bool bull = not p0.isHigh and p1.isHigh and not p2.isHigh
                     and p3.isHigh and not p4.isHigh and p5.isHigh
        bool bear = p0.isHigh and not p1.isHigh and p2.isHigh
                     and not p3.isHigh and p4.isHigh and not p5.isHigh

        float l1 = math.abs(p1.price - p0.price)
        float l3 = math.abs(p3.price - p2.price)
        float l5 = math.abs(p5.price - p4.price)

        bool r2 = bull ? p2.price > p0.price : p2.price < p0.price
        bool r3 = not (l3 < l1 and l3 < l5)
        float tol = l1 * ovTol
        bool r4 = bull ? p4.price > p1.price - tol : p4.price < p1.price + tol
        bool r5 = not need5 or (bull ? p5.price > p3.price : p5.price < p3.price)
        bool rBi = p1.bi > p0.bi and p2.bi > p1.bi and p3.bi > p2.bi
                     and p4.bi > p3.bi and p5.bi > p4.bi
        bool rSpan = maxSpan == 0 or (p5.bi - p0.bi) <= maxSpan

        if (bull or bear) and r2 and r3 and r4 and r5 and rBi and rSpan
            found := true
            L.hits := L.hits + 1
            L.lastDir := bull ? 1 : -1
            bool star = fibOn and l3 >= fibN * l1
            int  wThick = star ? L.wid + starW : L.wid

            if array.size(L.ws) > 0
                for i = 0 to array.size(L.ws) - 1
                    Wave wo = array.get(L.ws, i)
                    wo.expired := true

            float full = math.abs(p5.price - p0.price)
            Wave w = Wave.new(segs = array.new<line>(), lbs = array.new<label>(),
                 bull = bull, p5px = p5.price,
                 tgtPx = bull ? p5.price - full * projRetr : p5.price + full * projRetr,
                 expired = false)

            array.push(w.segs, line.new(p0.bi, p0.price, p1.bi, p1.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))
            array.push(w.segs, line.new(p1.bi, p1.price, p2.bi, p2.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))
            array.push(w.segs, line.new(p2.bi, p2.price, p3.bi, p3.price,
                 xloc = xloc.bar_index, color = L.col, width = wThick))
            array.push(w.segs, line.new(p3.bi, p3.price, p4.bi, p4.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))
            array.push(w.segs, line.new(p4.bi, p4.price, p5.bi, p5.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))

            for k = 1 to 5
                Piv q  = array.get(L.pv, n - 6 + k)
                Piv qp = array.get(L.pv, n - 7 + k)
                string txt = "(" + str.tostring(k) + ")" + (k == 3 and star ? " ★" : "")
                float dW = q.price - qp.price
                string rel = ""
                if k == 2
                    rel := "回撤浪1 的 " + str.tostring(math.abs(dW) / l1, "#.###")
                else if k == 3
                    rel := "= " + str.tostring(l3 / l1, "#.##") + " × 浪1" + (star ? "  ★ 达到加分比例" : "")
                else if k == 4
                    rel := "回撤浪3 的 " + str.tostring(math.abs(dW) / l3, "#.###")
                else if k == 5
                    rel := "= " + str.tostring(l5 / l1, "#.##") + " × 浪1"
                string tipW = "级别「" + L.name + "」 · 已确认的推动浪 · 浪" + str.tostring(k)
                     + "\n终点 " + str.tostring(q.price, format.mintick)
                     + "\n这一浪 " + (dW >= 0 ? "+" : "") + str.tostring(dW, format.mintick)
                     + "（" + (dW >= 0 ? "+" : "") + str.tostring(dW / qp.price * 100, "#.#") + "%）/ "
                     + str.tostring(q.bi - qp.bi) + " 根"
                     + (rel != "" ? "\n" + rel : "")
                array.push(w.lbs, label.new(q.bi, q.price, txt, xloc = xloc.bar_index,
                     style = q.isHigh ? label.style_label_down : label.style_label_up,
                     color = color.new(L.col, 25), textcolor = color.white, size = szLbl, tooltip = tipW))

            array.push(L.ws, w)
            if array.size(L.ws) > maxPat
                delWave(array.shift(L.ws))
    found

method sweep(Lv L) =>
    if array.size(L.ws) > 0
        for i = 0 to array.size(L.ws) - 1
            Wave w = array.get(L.ws, i)
            if not w.expired and not na(w.tgtPx)
                bool hit   = w.bull ? low <= w.tgtPx : high >= w.tgtPx
                bool inval = w.bull ? close > w.p5px : close < w.p5px
                if hit or inval
                    w.expired := true

method activeTgt(Lv L) =>
    float t = na
    if array.size(L.ws) > 0
        for i = 0 to array.size(L.ws) - 1
            Wave w = array.get(L.ws, i)
            if not w.expired and not na(w.tgtPx)
                t := w.tgtPx
    t

scName(int j) =>
    j == 0 ? "(1)" : j == 1 ? "(2)" : j == 2 ? "(3)" : j == 3 ? "(4)" : j == 4 ? "(5)" : j == 5 ? "A" : j == 6 ? "B" : j == 7 ? "C" : j == 8 ? "(1)′" : "(2)′"

scImp(int j) =>
    j == 0 or j == 2 or j == 4 or j == 5 or j == 7 or j == 8

scValid(Lv L, int k) =>
    int n = array.size(L.pv)
    Piv q0 = array.get(L.pv, n - 1 - k)
    bool bull = not q0.isHigh
    float s = bull ? 1.0 : -1.0
    bool ok = true
    array<float> x = array.new<float>()
    for i = 0 to k
        Piv qi = array.get(L.pv, n - 1 - k + i)
        array.push(x, s * qi.price)
        if qi.isHigh != ((i % 2 == 1) == bull)
            ok := false
        if i > 0
            Piv qp = array.get(L.pv, n - 2 - k + i)
            if qi.bi <= qp.bi
                ok := false
    float xe = s * L.ext
    if ok and k >= 1
        float l1 = array.get(x, 1) - array.get(x, 0)
        if maxSpan > 0 and bar_index - q0.bi > maxSpan
            ok := false
        if k >= 2
            if not (array.get(x, 2) > array.get(x, 0))
                ok := false
        if k >= 3
            if not (array.get(x, 3) > array.get(x, 1))
                ok := false
        if k >= 4
            if not (array.get(x, 4) > array.get(x, 1) - ovTol * l1)
                ok := false
        if k >= 5
            float l3 = array.get(x, 3) - array.get(x, 2)
            float l5 = array.get(x, 5) - array.get(x, 4)
            if l3 < l1 and l3 < l5
                ok := false
            if need5
                if not (array.get(x, 5) > array.get(x, 3))
                    ok := false
        if k >= 6
            if not (array.get(x, 6) > array.get(x, 0))
                ok := false
        if k >= 7
            if not (array.get(x, 5) > array.get(x, 7))
                ok := false
        if k == 1
            if not (xe > array.get(x, 0))
                ok := false
        if k == 3
            if not (xe > array.get(x, 1) - ovTol * l1)
                ok := false
        if k == 5 or k == 7
            if not (xe > array.get(x, 0))
                ok := false
        if k == 6
            if not (array.get(x, 5) > xe)
                ok := false
    ok

scTgt(array<float> E, float x0, int j, bool ext, float eps) =>
    float e0 = array.get(E, 0)
    float L1 = na(e0) ? na : e0 - x0
    float t = na
    string why = ""
    string brf = ""
    if j == 1
        float r = ext ? 0.786 : ret2
        t := math.max(e0 - r * L1, x0 + eps)
        why := "浪2 回撤浪1 的 " + str.tostring(r)
        brf := "回撤浪1 " + str.tostring(r)
    else if j == 2
        float r = fib3 + (ext ? 1.0 : 0.0)
        t := math.max(array.get(E, 1) + r * L1, e0 + eps)
        why := "浪3 = " + str.tostring(r) + " × 浪1，从浪2 终点量起"
        brf := str.tostring(r) + "×浪1"
    else if j == 3
        float r = ext ? 0.5 : ret4
        float l3a = array.get(E, 2) - array.get(E, 1)
        t := array.get(E, 2) - r * l3a
        why := "浪4 回撤浪3 的 " + str.tostring(r)
        brf := "回撤浪3 " + str.tostring(r)
        float floor4 = e0 - ovTol * L1 + eps
        if t < floor4
            t := floor4
            why := why + "；会进浪1 区间，被抬到浪1 终点之外"
            brf := brf + "·不进浪1"
    else if j == 4
        float r = fib5 + (ext ? 0.618 : 0.0)
        float l3b = array.get(E, 2) - array.get(E, 1)
        t := array.get(E, 3) + r * L1
        why := "浪5 = " + str.tostring(r) + " × 浪1，从浪4 终点量起"
        brf := str.tostring(r) + "×浪1"
        if t <= array.get(E, 2)
            t := array.get(E, 3) + 0.618 * (array.get(E, 2) - x0)
            why := "浪3 延长，「浪5 = 浪1」过不了浪3 → 改用 浪5 = 0.618 × (浪1 起点 → 浪3 终点)"
            brf := "0.618×(1→3)"
        if l3b < L1 and t > array.get(E, 3) + l3b
            t := array.get(E, 3) + l3b
            why := why + "；浪3 比浪1 短，浪5 不能比浪3 长（否则浪3 成了最短）"
            brf := brf + "·≤浪3长"
        if need5 and t < array.get(E, 2) + eps
            t := array.get(E, 2) + eps
            why := why + "；被抬到刚好越过浪3 终点"
            brf := brf + "·过浪3"
    else if j == 5
        float a = projRetr * (array.get(E, 4) - x0) / (2.0 - retB)
        t := math.max(array.get(E, 4) - a * (ext ? 1.618 : 1.0), x0 + eps)
        why := "ABC 合计回撤推动浪的 " + str.tostring(projRetr) + "；按锯齿形分配 A = 合计 ÷ (2 − "
             + str.tostring(retB) + ")" + (ext ? "，再 × 1.618 延长" : "")
        brf := "ABC合计回撤 " + str.tostring(projRetr) + (ext ? "·×1.618" : "")
    else if j == 6
        float r = ext ? 0.786 : retB
        float aB = array.get(E, 4) - array.get(E, 5)
        t := array.get(E, 5) + r * aB
        why := "B 回撤 A 的 " + str.tostring(r)
        brf := "回撤A " + str.tostring(r)
        if t > array.get(E, 4) - eps
            t := array.get(E, 4) - eps
            why := why + "；被压在浪5 终点之下"
            brf := brf + "·<浪5"
    else if j == 7
        float r = ext ? 1.618 : 1.0
        float aC = array.get(E, 4) - array.get(E, 5)
        t := array.get(E, 6) - r * aC
        why := "C = " + str.tostring(r) + " × A，从 B 终点量起"
        brf := "C=" + str.tostring(r) + "×A"
        if t < x0 + eps
            t := x0 + eps
            why := why + "；被抬到推动浪起点之上"
            brf := brf + "·>起点"
    else if j == 8
        t := array.get(E, 7) + L1
        why := "下一轮浪1：假设和上一轮浪1 一样长（没有更好的参照）"
        brf := "≈上轮浪1"
    else if j == 9
        t := array.get(E, 8) - ret2 * L1
        why := "下一轮浪2 回撤浪1 的 " + str.tostring(ret2)
        brf := "回撤浪1 " + str.tostring(ret2)
    [t, why, brf]

method clearScen(Lv L) =>
    if array.size(L.sL) > 0
        for i = 0 to array.size(L.sL) - 1
            line.delete(array.get(L.sL, i))
        array.clear(L.sL)
    if array.size(L.sB) > 0
        for i = 0 to array.size(L.sB) - 1
            label.delete(array.get(L.sB, i))
        array.clear(L.sB)
    line.delete(L.sRay)

method scenario(Lv L) =>
    L.clearScen()
    L.sK    := -1
    L.sP0   := -1
    L.note  := ""
    L.note2 := ""
    L.tip   := ""
    array.clear(L.dCells)
    int n = array.size(L.pv)
    if L.dir == 0 or n < 2
        L.note := "枢轴不足（" + str.tostring(n) + " 个）"
        L.tip  := "图上确认的枢轴还不到 2 个，没法判断位置。刚加载、或者阈值太大时会这样。"
    else
        int kk = 0
        for k = math.min(7, n - 1) to 0
            if scValid(L, k)
                kk := k
                break
        Piv q0 = array.get(L.pv, n - 1 - kk)
        bool bull = not q0.isHigh
        float s = bull ? 1.0 : -1.0
        float xe = s * L.ext
        float x0 = s * q0.price
        float eps = syminfo.mintick

        array<float> E = array.new<float>(10, na)
        if kk > 0
            for j = 0 to kk - 1
                Piv pj0 = array.get(L.pv, n - kk + j)
                array.set(E, j, s * pj0.price)
        bool running = bar_index - L.extBi <= 1
        bool done = false
        bool extd = false
        array<string> W  = array.new<string>(10, "")
        array<string> Wb = array.new<string>(10, "")
        for j = kk to 9
            float t = xe
            string why = "新的浪1：没有更早的参照，假设在当前极值处走完"
            string brf = "当前极值"
            if j > 0
                [t0, w0, bf0] = scTgt(E, x0, j, false, eps)
                t := t0
                why := w0
                brf := bf0
            if j == kk
                bool up = j % 2 == 0
                bool beyond = up ? xe >= t : xe <= t
                if beyond and running and j > 0
                    float tOrig = t
                    [t1, w1, bf1] = scTgt(E, x0, j, true, eps)
                    t := t1
                    extd := true
                    why := "越过原目标 " + str.tostring(s * tOrig, format.mintick) + "、还在走 → 取延长档：" + w1
                    brf := "延长·" + bf1
                    beyond := up ? xe >= t : xe <= t
                if beyond and j > 0
                    why := "实际已走到 " + str.tostring(L.ext, format.mintick)
                         + (extd ? "，连延长档 " : "，越过目标 ") + str.tostring(s * t, format.mintick)
                         + (extd ? " 都越过了" : " 之后已回头") + " → 暂按在这里走完。原目标：" + why
                    brf := "实际极值"
                else if not beyond
                    why := why + "。正在走，目前走到 " + str.tostring(L.ext, format.mintick)
                array.set(E, j, beyond ? xe : t)
                done := beyond
            else
                array.set(E, j, t)
            array.set(W, j, why)
            array.set(Wb, j, brf)

        array<float> vi = array.new<float>()
        array<float> vc = array.new<float>()
        if kk > 0
            for i = 0 to kk - 1
                Piv a0 = array.get(L.pv, n - 1 - kk + i)
                Piv a1 = array.get(L.pv, n - kk + i)
                float va0 = math.abs(a1.price - a0.price) / math.max(1, a1.bi - a0.bi)
                if scImp(i)
                    array.push(vi, va0)
                else
                    array.push(vc, va0)
        Piv pk = array.get(L.pv, n - 1)
        if L.extBi - pk.bi >= 3
            float va1 = math.abs(L.ext - pk.price) / (L.extBi - pk.bi)
            if scImp(kk)
                array.push(vi, va1)
            else
                array.push(vc, va1)
        array<float> vAllArr = array.new<float>()
        for i = math.max(0, n - 11) to n - 2
            Piv b0 = array.get(L.pv, i)
            Piv b1 = array.get(L.pv, i + 1)
            array.push(vAllArr, math.abs(b1.price - b0.price) / math.max(1, b1.bi - b0.bi))
        float vAll = array.median(vAllArr)
        array.push(vi, vAll)
        array.push(vc, vAll)
        float vImp = math.max(array.avg(vi), syminfo.mintick)
        float vCor = math.max(array.avg(vc), syminfo.mintick)

        float xc = s * close
        array<int>   pt = array.new<int>()
        array<float> px = array.new<float>()
        array<int>   pw = array.new<int>()
        int f = done ? kk + 1 : kk
        if done
            array.push(pt, L.extBi)
            array.push(px, array.get(E, kk))
        else
            array.push(pt, bar_index)
            array.push(px, xc)
        array.push(pw, -1)
        int lastJ = math.min(f + projLegs - 1, 9)
        int tPrev = array.get(pt, 0)
        float xPrev = array.get(px, 0)
        for j = f to lastJ
            float xj = array.get(E, j)
            float vj = scImp(j) ? vImp : vCor
            int tj = tPrev + math.max(1, int(math.round(math.abs(xj - xPrev) / vj)))
            if tj <= bar_index
                tj := bar_index + math.max(1, int(math.round(math.abs(xj - xc) / vj)))
            array.push(pt, tj)
            array.push(px, xj)
            array.push(pw, j)
            tPrev := tj
            xPrev := xj

        int np = array.size(pt)
        int far = array.get(pt, np - 1) - bar_index
        if far > 480
            float sc = 480.0 / far
            int prevT = array.get(pt, 0)
            for ci = 1 to np - 1
                int ti = array.get(pt, ci)
                int tn = ti > bar_index ? bar_index + math.max(1, int(math.round((ti - bar_index) * sc))) : ti
                tn := math.max(tn, prevT + 1)
                array.set(pt, ci, tn)
                prevT := tn

        color c = L.col
        bool fullLbl = direct or projLbl != "浪名"
        if done
            string tipD = "级别「" + L.name + "」 · " + scName(kk) + "?\n\n" + array.get(W, kk)
                 + "\n\nZigZag 还没确认反转（反向还没走出 ATR×" + str.tostring(L.mult)
                 + "），所以这是假设：如果这一浪其实还在延长，下一根会重算。"
            array.push(L.sB, label.new(L.extBi, L.ext,
                 (fullLbl ? L.name + " " : "") + scName(kk) + "?",
                 xloc = xloc.bar_index,
                 style = (kk % 2 == 0) == bull ? label.style_label_down : label.style_label_up,
                 color = color.new(c, 55), textcolor = color.white, size = szLbl, tooltip = tipD))
        for di = 1 to np - 1
            int wj = array.get(pw, di)
            float y0 = s * array.get(px, di - 1)
            float y1 = s * array.get(px, di)
            array.push(L.sL, line.new(array.get(pt, di - 1), y0, array.get(pt, di), y1,
                 xloc = xloc.bar_index, color = c, style = stPrj, width = pWidth))
            float chg = (y1 / close - 1.0) * 100.0
            string chgS = (chg >= 0 ? "+" : "") + str.tostring(chg, "#.#") + "%"
            int ahead = array.get(pt, di) - bar_index
            string when = "约 " + str.tostring(ahead) + " 根后 ≈ "
                 + str.format_time(time + ahead * tfSec * 1000, tfSec >= 86400 ? "yyyy-MM-dd" : "yyyy-MM-dd HH:mm",
                 syminfo.timezone) + "（按连续交易估算）"
            int dBars = math.max(1, array.get(pt, di) - array.get(pt, di - 1))
            float dPx = y1 - y0
            string tipP = "级别「" + L.name + "」 · 推演第 " + str.tostring(di) + " 段 · " + scName(wj)
                 + "\n终点 " + str.tostring(y1, format.mintick) + "   离现价 " + chgS
                 + "\n" + when
                 + "\n\n高度：" + array.get(W, wj)
                 + "\n\n角度：这一段 " + (dPx >= 0 ? "+" : "") + str.tostring(dPx, format.mintick)
                 + " / " + str.tostring(dBars) + " 根 = " + str.tostring(dPx / dBars, format.mintick) + " / 根"
                 + "\n（" + (scImp(wj) ? "推动" : "调整") + "腿实测速度 "
                 + str.tostring(scImp(wj) ? vImp : vCor, format.mintick) + " / 根）"
            string lblTxt = scName(wj)
            if fullLbl
                lblTxt := L.name + " " + scName(wj) + "  " + str.tostring(y1, format.mintick) + "  " + chgS
            array.push(L.sB, label.new(array.get(pt, di), y1, lblTxt,
                 xloc = xloc.bar_index,
                 style = (wj % 2 == 0) == bull ? label.style_label_down : label.style_label_up,
                 color = color.new(c, 25), textcolor = color.white, size = szLbl, tooltip = tipP))
        float yEnd = s * array.get(px, np - 1)
        if projRay
            int tEnd = array.get(pt, np - 1)
            L.sRay := line.new(tEnd, yEnd, tEnd + 1, yEnd, xloc = xloc.bar_index,
                 extend = extend.right, color = color.new(c, 50), style = line.style_dotted, width = 1)

        L.sK  := kk
        L.sP0 := q0.bi
        string pos = scName(kk) + (done ? (extd ? "? 越过延长档" : "? 越过目标·已回头") : extd ? " 延长中" : " 进行中")
        float l1v = array.get(E, 0) - x0
        if (kk >= 2 or (kk == 1 and done)) and l1v > 0
            float r2 = (array.get(E, 0) - array.get(E, 1)) / l1v
            if r2 > 0.886
                pos := pos + " ⚠浪2回撤" + str.tostring(r2 * 100, "#") + "%"
        if L.pvTotal < 12
            pos := "⚠枢轴少 · " + pos
        L.note := pos
        float chgEnd = (yEnd / close - 1.0) * 100.0
        L.note2 := scName(array.get(pw, np - 1)) + " " + str.tostring(yEnd, format.mintick)
             + " (" + (chgEnd >= 0 ? "+" : "") + str.tostring(chgEnd, "#.#") + "%)"

        if done
            float cD = (L.ext / close - 1.0) * 100.0
            array.push(L.dCells, scName(kk) + "?")
            array.push(L.dCells, str.tostring(L.ext, format.mintick))
            array.push(L.dCells, (cD >= 0 ? "+" : "") + str.tostring(cD, "#.#") + "%")
            array.push(L.dCells, "已发生")
            array.push(L.dCells, array.get(Wb, kk))
        for ri = 1 to np - 1
            int wr = array.get(pw, ri)
            float yr = s * array.get(px, ri)
            float cr = (yr / close - 1.0) * 100.0
            int ar = array.get(pt, ri) - bar_index
            array.push(L.dCells, scName(wr))
            array.push(L.dCells, str.tostring(yr, format.mintick))
            array.push(L.dCells, (cr >= 0 ? "+" : "") + str.tostring(cr, "#.#") + "%")
            array.push(L.dCells, "约 " + str.tostring(ar) + " 根 · "
                 + str.format_time(time + ar * tfSec * 1000, tfSec >= 86400 ? "MM-dd" : "MM-dd HH:mm", syminfo.timezone))
            array.push(L.dCells, array.get(Wb, wr))
        array.push(L.dCells, "速度")
        array.push(L.dCells, "推动腿")
        array.push(L.dCells, str.tostring(vImp, format.mintick) + "/根")
        array.push(L.dCells, "调整腿")
        array.push(L.dCells, str.tostring(vCor, format.mintick) + "/根")

        string tp = "当前位置：" + pos + "\n\n推演路径（从现在起）："
        if done
            tp := tp + "\n  " + scName(kk) + "?   " + str.tostring(L.ext, format.mintick)
                 + "   越过目标、已回头，暂按在这里走完"
        else
            tp := tp + "\n  现在   " + str.tostring(close, format.mintick)
        for hi = 1 to np - 1
            float yv = s * array.get(px, hi)
            float cv = (yv / close - 1.0) * 100.0
            tp := tp + "\n  " + scName(array.get(pw, hi)) + "   " + str.tostring(yv, format.mintick)
                 + "   " + (cv >= 0 ? "+" : "") + str.tostring(cv, "#.#") + "%"
                 + "   约 " + str.tostring(array.get(pt, hi) - bar_index) + " 根后"
        tp := tp + "\n\n角度依据 · 实测速度：推动腿 " + str.tostring(vImp, format.mintick)
             + " / 根，调整腿 " + str.tostring(vCor, format.mintick) + " / 根"
        L.tip := tp

LA.mult := useA
LA.col  := cA
LA.wid  := wA
LA.on   := onA
LB.mult := useB
LB.col  := cB
LB.wid  := wB
LB.on   := onB
LC.mult := useC
LC.col  := cC
LC.wid  := wC
LC.on   := onC

bool hitA = false
bool hitB = false
bool hitC = false

if LA.on and atrOk and LA.zigzag(atrV * LA.mult)
    hitA := LA.detect()
if LB.on and atrOk and LB.zigzag(atrV * LB.mult)
    hitB := LB.detect()
if LC.on and atrOk and LC.zigzag(atrV * LC.mult)
    hitC := LC.detect()

LA.sweep()
LB.sweep()
LC.sweep()

if showProj and barstate.islast
    if LA.on
        LA.scenario()
    if LB.on
        LB.scenario()
        if LA.on and LB.sK >= 0 and LB.sK == LA.sK and LB.sP0 == LA.sP0
            LB.clearScen()
            LB.note := "同「" + LA.name + "」的场景，不重复画"
            LB.note2 := ""
            LB.tip := "和「" + LA.name + "」选中了同一个起点和位置，推演路径完全一样，"
                 + "图上只画「" + LA.name + "」那条。\n\n" + LA.tip
            LB.dCells := array.copy(LA.dCells)
    if LC.on
        LC.scenario()
        if LA.on and LC.sK >= 0 and LC.sK == LA.sK and LC.sP0 == LA.sP0
            LC.clearScen()
            LC.note := "同「" + LA.name + "」的场景，不重复画"
            LC.note2 := ""
            LC.tip := "和「" + LA.name + "」选中了同一个起点和位置，推演路径完全一样，"
                 + "图上只画「" + LA.name + "」那条。\n\n" + LA.tip
            LC.dCells := array.copy(LA.dCells)
        else if LB.on and LC.sK >= 0 and LC.sK == LB.sK and LC.sP0 == LB.sP0
            LC.clearScen()
            LC.note := "同「" + LB.name + "」的场景，不重复画"
            LC.note2 := ""
            LC.tip := "和「" + LB.name + "」选中了同一个起点和位置，推演路径完全一样，"
                 + "图上只画「" + LB.name + "」那条。\n\n" + LB.tip
            LC.dCells := array.copy(LB.dCells)

float tgtA = LA.on ? LA.activeTgt() : na
float tgtB = LB.on ? LB.activeTgt() : na
float tgtC = LC.on ? LC.activeTgt() : na
bool  wvBull = (hitA and LA.lastDir > 0) or (hitB and LB.lastDir > 0) or (hitC and LC.lastDir > 0)
bool  wvBear = (hitA and LA.lastDir < 0) or (hitB and LB.lastDir < 0) or (hitC and LC.lastDir < 0)

method tblRow(Lv L, table tb, int r, float m) =>
    string tp = "级别「" + L.name + "」   ATR×" + str.tostring(m) + (tfAuto ? "（按周期自动）" : "（手动）")
         + "\n已确认枢轴 " + str.tostring(L.pvTotal) + " 个 · 完整 1-5 共 " + str.tostring(L.hits) + " 组"
    if not L.on
        tp := "级别「" + L.name + "」已关闭（输入页 ① 组打开）"
    else if not showProj
        tp := tp + "\n\n场景推演已关闭（输入页 ③ 组打开）"
    else
        tp := tp + "\n\n" + L.tip
    table.cell(tb, 0, r, L.name, text_color = L.col, text_size = szT, tooltip = tp)
    table.cell(tb, 1, r, L.on ? "ATR×" + str.tostring(m) : "关", text_color = L.col, text_size = szT,
         tooltip = tp)
    table.cell(tb, 2, r, L.on ? str.tostring(L.pvTotal) + " · " + str.tostring(L.hits) : "",
         text_color = L.col, text_size = szT, tooltip = tp)
    table.cell(tb, 3, r, L.on ? (showProj ? L.note : "推演已关闭") : "",
         text_color = L.col, text_size = szT, text_halign = text.align_left, tooltip = tp)
    table.cell(tb, 4, r, L.on and showProj ? L.note2 : "",
         text_color = L.col, text_size = szT, text_halign = text.align_left, tooltip = tp)

if showTbl and barstate.islast
    var table tb = table.new(posT, 5, 14,
         bgcolor = color.new(color.black, 15), border_width = 1,
         border_color = color.new(color.gray, 60),
         frame_width = 1, frame_color = color.new(color.gray, 40))
    string hTip = "鼠标移到下面任意一行上，会弹出那一行的完整明细。\n\n"
         + "级别：细 / 中 / 粗\n"
         + "阈值：实际生效的 ATR 倍数\n"
         + "枢轴·命中：累计确认的枢轴数 · 完整 1-5 组数\n"
         + "当前位置：现在在走哪一浪\n"
         + "推演终点：推演最后一段的终点价和离现价多少 %\n\n"
         + "字号在输入页 ④ 组「右下角状态表 · 字号」里改。"
    table.cell(tb, 0, 0, "级别",      text_color = color.silver, text_size = szT, tooltip = hTip)
    table.cell(tb, 1, 0, tfAuto ? "阈值(自动)" : "阈值(手动)", text_color = color.silver, text_size = szT,
         tooltip = hTip)
    table.cell(tb, 2, 0, "枢轴·命中", text_color = color.silver, text_size = szT, tooltip = hTip)
    table.cell(tb, 3, 0, "当前位置",  text_color = color.silver, text_size = szT, tooltip = hTip)
    table.cell(tb, 4, 0, "推演终点",  text_color = color.silver, text_size = szT, tooltip = hTip)
    LA.tblRow(tb, 1, useA)
    LB.tblRow(tb, 2, useB)
    LC.tblRow(tb, 3, useC)
    string fTip = "图上共 " + str.tostring(bar_index + 1) + " 根K线。\n\n"
         + "「?」= 这一浪已越过斐波那契目标、价格也已回头，暂按「在极值处走完」往下推。"
         + "ZigZag 还没确认反转，所以这只是假设。\n\n"
         + "推演只在最后一根上画，每来一根新K线都会重新判断位置、重画路径。\n\n"
         + "推演是规则的机械推论，不是信号。"
    table.cell(tb, 0, 4, "⚠", text_color = color.orange, text_size = szT, tooltip = fTip)
    table.cell(tb, 1, 4, str.tostring(bar_index + 1) + " 根", text_color = color.orange, text_size = szT,
         tooltip = fTip)
    table.cell(tb, 2, 4, direct ? "明细见下方" : "悬停看明细", text_color = color.orange, text_size = szT,
         tooltip = fTip)
    table.cell(tb, 3, 4, "? = 越过目标已回头，暂按走完", text_color = color.orange, text_size = szT,
         text_halign = text.align_left, tooltip = fTip)
    table.cell(tb, 4, 4, "推演是推论，不是信号", text_color = color.orange, text_size = szT,
         text_halign = text.align_left, tooltip = fTip)

    table.clear(tb, 0, 5, 4, 13)
    if direct and showProj
        Lv D = LA
        if detailLv == "中"
            D := LB
        else if detailLv == "粗"
            D := LC
        table.cell(tb, 0, 5, "「" + D.name + "」明细", text_color = D.col, text_size = szT)
        table.cell(tb, 1, 5, "价位",           text_color = color.silver, text_size = szT)
        table.cell(tb, 2, 5, "离现价",         text_color = color.silver, text_size = szT)
        table.cell(tb, 3, 5, "约几根后 · 日期", text_color = color.silver, text_size = szT)
        table.cell(tb, 4, 5, "依据",           text_color = color.silver, text_size = szT)
        int nd = int(array.size(D.dCells) / 5)
        if not D.on
            table.cell(tb, 0, 6, "这个级别没开", text_color = color.silver, text_size = szT)
        else if nd == 0
            table.cell(tb, 0, 6, "暂无推演", text_color = color.silver, text_size = szT)
        else
            for ri = 0 to math.min(nd, 8) - 1
                for ci = 0 to 4
                    table.cell(tb, ci, 6 + ri, array.get(D.dCells, ri * 5 + ci),
                         text_color = ri == nd - 1 ? color.silver : D.col, text_size = szT,
                         text_halign = ci == 4 ? text.align_left : text.align_center)

alertcondition(hitA or hitB or hitC, "推动浪成立（任意级别）", "1-2-3-4-5 推动浪校验通过")
alertcondition(hitA, "推动浪成立 · 细", "级别「细」出现 1-2-3-4-5")
alertcondition(hitB, "推动浪成立 · 中", "级别「中」出现 1-2-3-4-5")
alertcondition(hitC, "推动浪成立 · 粗", "级别「粗」出现 1-2-3-4-5")

plot(tgtA, "细 · 已确认推动浪的调整目标", color = #42a5f5, linewidth = 1,
     style = plot.style_linebr, display = display.pane)
plot(tgtB, "中 · 已确认推动浪的调整目标", color = #ab47bc, linewidth = 1,
     style = plot.style_linebr, display = display.pane)
plot(tgtC, "粗 · 已确认推动浪的调整目标", color = #ffa726, linewidth = 1,
     style = plot.style_linebr, display = display.pane)

plotshape(wvBull, "事件 · 看涨推动浪成立", shape.triangleup, location.belowbar,
     color = #26a69a, size = size.small)
plotshape(wvBear, "事件 · 看跌推动浪成立", shape.triangledown, location.abovebar,
     color = #ef5350, size = size.small)
