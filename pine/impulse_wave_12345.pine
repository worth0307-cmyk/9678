//@version=6
// =============================================================================
// 推动浪 1-2-3-4-5  —  多级别 ZigZag + 艾略特硬规则校验 + 斐波那契推演
// =============================================================================
// 骨架和 quasimodo_zones.pine 完全一样：
//   ①输入 → ②枢轴序列 → ③形态对象 → ④检测 → ⑤每根维护 → ⑥警报
// 换别的形态时只改 ④。
//
// 枢轴用 ATR×倍数的反转阈值（ZigZag），不用 ta.pivot*：
//   pivot 的 left/right 是**根数**，同一个 left=5 在暴涨和横盘里量到的东西
//   完全不是一回事；ATR 阈值量的是**幅度**，三个倍数（×2 / ×4 / ×8）才真的
//   构成三个级别。
//
// 硬规则只有三条半（第四条可关）：
//   浪2 不跌破浪起点 P0
//   浪3 不是 1、3、5 中最短的
//   浪4 不进入浪1 的价格区间
//   （可选）浪5 超越浪3 端点 —— 关掉就允许衰竭浪
// 斐波那契比例只做加分项：浪3 ≥ 1.618×浪1 时把那一段画粗、标 ★。
//
// ⚠ 重绘与「拉伸时间轴后线变了」：
//   已确认的枢轴在**同一次计算里**不重绘。但 ZigZag 是路径依赖的 —— 它从图表
//   最早那根开始滚，往左拖加载了更多历史之后 TradingView 会整个重算，起点变了，
//   整串枢轴就可能落在不同的位置。这不是画错，是这类算法的固有性质。
//   本版把方向播种改成「双向跟踪、谁先反转谁定方向」，把这个漂移压到最小，
//   但压不到零。最新一浪在当根K线走完前同样会反复出现/消失。
// =============================================================================

indicator("推动浪 1-2-3-4-5 多级别", "Impulse 1-5", overlay = true,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// ───────────────────────────────────────────────────────── 1. 输入

gZ = "① ZigZag（ATR 反转阈值）"
atrLen = input.int(14, "ATR 周期", minval = 1, group = gZ)
mA = input.float(2.0, "级别 A 阈值 = ATR ×", minval = 0.2, step = 0.5, group = gZ)
mB = input.float(4.0, "级别 B 阈值 = ATR ×", minval = 0.2, step = 0.5, group = gZ)
mC = input.float(8.0, "级别 C 阈值 = ATR ×", minval = 0.2, step = 0.5, group = gZ)
onA = input.bool(true,  "启用级别 A（最细）", group = gZ)
onB = input.bool(true,  "启用级别 B",        group = gZ)
onC = input.bool(false, "启用级别 C（最粗）", group = gZ)

gR = "② 校验规则"
need5 = input.bool(true, "浪5 必须超越浪3 端点", group = gR,
     tooltip = "关掉 = 允许衰竭浪（truncated fifth）。这是你三条硬规则之外我加的第四条，" +
               "所以做成开关：衰竭浪在艾略特里合法但少见，默认打开能少掉很多噪声数浪。")
ovTol = input.float(0.0, "浪4 允许重叠浪1 的比例", minval = 0.0, maxval = 0.5, step = 0.01, group = gR,
     tooltip = "「浪4 不进浪1 价格区间」是艾略特最硬的一条，默认 0 = 一点都不让。\n\n" +
               "但**对角线形态（leading / ending diagonal）在艾略特里本来就允许重叠**，" +
               "所以给一个容差，单位是浪1 长度的比例。\n\n" +
               "实测 BTC 日线 2026-09：级别B 的浪4 只侵入了浪1 的 4.9% 就被判出局，" +
               "而级别A 侵入 33%、级别C 侵入 23.6%。把这个值设到 0.06，" +
               "级别B 那一组 1-5 就会成立并画出推演；A 和 C 仍然出局。\n\n" +
               "**调这个值是在放宽定义，不是在改进检测。** 放得越宽，命中越多，含义越少。")
fibOn = input.bool(true,  "浪3 ≥ N×浪1 时加粗标 ★（仅加分）", group = gR)
fibN  = input.float(1.618, "加分比例 N", minval = 0.5, step = 0.1, group = gR)
maxPat = input.int(1, "每个级别保留最近几组", minval = 1, maxval = 8, group = gR,
     tooltip = "三个级别同时开、每级留 2 组，图上就是 30 条浪线 + 3 条推演线互相压。" +
               "默认 1 组：想看历史再往上加。")
maxSpan = input.int(300, "一组浪最大跨度（根，0 = 不限）", minval = 0, group = gR,
     tooltip = "**这条是为了让线跟着价格走。** 一组浪的连线是两个枢轴之间的直线；" +
               "枢轴隔了几百根的时候，两端都在屏幕外，中间那条直线就横穿图表，" +
               "落在和当地K线毫无关系的价位上 —— 看起来就像「线没跟着价格变化」。\n\n" +
               "实测：SOL 日线 ATR×8 唯一一组浪跨 752 根。默认 300 会把它筛掉，" +
               "所以级别 C 在日线上经常是 0 组 —— 那不是坏了，是日线上 ATR×8 的浪本来就以年计。")

gP = "③ 推演"
showProj = input.bool(true, "画推演", group = gP,
     tooltip = "1-5 走完之后按艾略特接的是 ABC 调整，所以推演画的是**调整目标**，不是第 6 浪。\n\n" +
               "价位 = P5 回撤 (1-5 全长) × 下面那个比例。这是几何外推，不是预测。")
projLast = input.bool(true, "只给每个级别最新的一组画", group = gP,
     tooltip = "**重要**：推演的终点是 P5 之后若干根。如果那一组浪早就走完了，" +
               "终点就落在已经发生过的历史里 —— 那不是预测，是一条画在旧K线上的斜线，" +
               "和浪线长得一模一样，正是你截图上看不清的原因。默认只给最新一组画。")
projRetr = input.float(0.5, "推演价位：回撤 1-5 全长的", minval = 0.05, maxval = 1.0, step = 0.05, group = gP)
projTime = input.float(0.5, "推演耗时：1-5 跨度的",     minval = 0.1, maxval = 3.0, step = 0.1, group = gP)
projRay  = input.bool(true, "在目标价上画一条水平射线", group = gP,
     tooltip = "斜线只告诉你「往那边走」，水平射线才让目标价**可读**：它一直延伸到右侧，" +
               "你能直接看出当前价离目标还有多远。")

tentOn = input.bool(true, "画待定推演（浪5 还在走的时候）", group = gP,
     tooltip = "正式推演要等 6 个枢轴全部确认。在那之前，只要前 5 个点已经构成一个合规的" +
               "浪1-4 前缀、而且当前正在往浪5 的方向走，就先按斐波那契**假设**一条：\n\n" +
               "  预期浪5 终点 = P4 ± 浪1 × 下面那个倍数（再按硬规则夹紧）\n" +
               "  再从那个假设的 P5 推出调整目标\n\n" +
               "**它每根都会变**——实时极值一动，假设的 P5 就动，目标也跟着动。所以用点线、" +
               "另一个颜色画，标签写「待定」。浪5 一确认，待定线消失，正式推演接上。\n\n" +
               "**这是假设，不是信号。** 它唯一的用处是让你提前知道「如果这一浪按教科书走，" +
               "目标大概在哪」。")
fib5 = input.float(1.0, "待定：预期浪5 = 浪1 ×", minval = 0.1, maxval = 3.0, step = 0.1, group = gP,
     tooltip = "1.0 = 等长浪（浪5 和浪1 一样长），艾略特里最常见的指引。\n" +
               "0.618 = 偏保守。1.618 = 延长浪。\n\n" +
               "算出来之后还要过两道夹紧：① 若 `浪5 超越浪3` 开着，强制超过 P3；" +
               "② 若浪3 比浪1 短，浪5 被限制在不超过浪3，否则「浪3 不是最短」会被自己破坏。")

gS = "④ 样式"
// 注：TradingView 的「样式」标签页只收 plot/plotshape 这类输出，line/label/box
// 这种绘图对象改不了颜色线宽 —— 所以全部放在这里，输入页第 ④ 组。
cA = input.color(#42a5f5, "级别 A 颜色", group = gS, inline = "A")
wA = input.int(2, "线宽", minval = 1, maxval = 6, group = gS, inline = "A")
cB = input.color(#ab47bc, "级别 B 颜色", group = gS, inline = "B")
wB = input.int(2, "线宽", minval = 1, maxval = 6, group = gS, inline = "B")
cC = input.color(#ffa726, "级别 C 颜色", group = gS, inline = "C")
wC = input.int(2, "线宽", minval = 1, maxval = 6, group = gS, inline = "C")
starW   = input.int(2, "浪3 达标时额外加粗", minval = 0, maxval = 4, group = gS)
lblSize = input.string("tiny", "标签大小", options = ["tiny", "small", "normal"], group = gS)

pCol   = input.color(#ff4081, "推演线颜色", group = gS, inline = "P")
pWidth = input.int(2, "线宽", minval = 1, maxval = 6, group = gS, inline = "P")
pStyle = input.string("虚线", "推演线样式", options = ["虚线", "点线", "实线"], group = gS)
tCol   = input.color(#90a4ae, "待定推演颜色", group = gS, inline = "T")
tWidth = input.int(1, "线宽", minval = 1, maxval = 4, group = gS, inline = "T")

showZZ = input.bool(false, "画出 ZigZag 骨架（调阈值时打开）", group = gS, inline = "Z")
zzW    = input.int(1, "线宽", minval = 1, maxval = 4, group = gS, inline = "Z")
zzT    = input.int(55, "透明度", minval = 0, maxval = 100, group = gS, inline = "Z")

showTbl = input.bool(true, "右下角状态表", group = gS)

// ATR 前 atrLen 根是 na。用 nz 兜底成 10 个 tick 的话，阈值近乎为零，
// ZigZag 会在开头几根上疯狂确认枢轴 —— 那些垃圾枢轴会一路喂进形态检测，
// 变成图左侧莫名其妙的一组浪。所以宁可等 ATR 有效再开始滚。
atrRaw = ta.atr(atrLen)
atrOk  = not na(atrRaw)
atrV   = nz(atrRaw, syminfo.mintick * 10.0)

szLbl = lblSize == "normal" ? size.normal : lblSize == "small" ? size.small : size.tiny
stPrj = pStyle == "实线" ? line.style_solid : pStyle == "点线" ? line.style_dotted : line.style_dashed

// ───────────────────────────────────────────────────────── 2. 枢轴序列

type Piv
    float price
    int   bi
    bool  isHigh

type Wave
    array<line>  segs
    array<label> lbs
    line  proj
    line  ray
    label projLb
    int   tgtBi      // 推演终点所在的 bar；走过它推演就过期了
    float tgtPx      // 推演目标价，样式页那一层要用
    bool  expired

type Lv
    string      name
    float       mult
    color       col
    int         wid
    bool        on
    int         dir      // +1 = 正在跟踪上升腿（找高点）, −1 = 下降腿, 0 = 还没定
    float       ext      // 当前腿的极值（播种期 = 跟踪中的高点）
    int         extBi
    float       ext2     // 只在播种期用：跟踪中的低点
    int         ext2Bi
    array<Piv>  pv
    array<Wave> ws
    array<line> zz
    int         hits
    int         lastDir   // 最近一次命中的方向：+1 看涨, −1 看跌（样式页分色用）
    line        tW5       // 待定：P4 -> 假设的浪5 终点
    line        tAB       // 待定：假设的 P5 -> 调整目标
    line        tRay      // 待定：目标价水平射线
    label       tLb
    string      note      // 状态表用：现在卡在哪一条

var Lv LA = Lv.new(name = "A", mult = mA, col = cA, wid = wA, on = onA, dir = 0,
     ext = na, extBi = na, ext2 = na, ext2Bi = na,
     pv = array.new<Piv>(), ws = array.new<Wave>(), zz = array.new<line>(),
     hits = 0, lastDir = 0, note = "")
var Lv LB = Lv.new(name = "B", mult = mB, col = cB, wid = wB, on = onB, dir = 0,
     ext = na, extBi = na, ext2 = na, ext2Bi = na,
     pv = array.new<Piv>(), ws = array.new<Wave>(), zz = array.new<line>(),
     hits = 0, lastDir = 0, note = "")
var Lv LC = Lv.new(name = "C", mult = mC, col = cC, wid = wC, on = onC, dir = 0,
     ext = na, extBi = na, ext2 = na, ext2Bi = na,
     pv = array.new<Piv>(), ws = array.new<Wave>(), zz = array.new<line>(),
     hits = 0, lastDir = 0, note = "")

// ZigZag 单步。返回：本根是否**确认**了一个新枢轴。
// 确认条件是收盘价从当前腿的极值反向走出 thr —— 收盘才算，所以枢轴一旦确认
// 就不会被后来的行情抹掉（极值点本身在过去，不需要未来数据）。
method zigzag(Lv L, float thr) =>
    bool confirmed = false

    if L.dir == 0
        // 播种期：**同时**跟踪最高和最低，谁先反向走出 thr 谁定方向。
        // 旧版硬性假设「第一条腿是上升腿」，那会让最早一两个枢轴系统性偏一边，
        // 而 ZigZag 是路径依赖的 —— 一个偏掉的起点能把后面整串都挪位。
        if na(L.ext)
            L.ext    := high
            L.extBi  := bar_index
            L.ext2   := low
            L.ext2Bi := bar_index
        else
            if high > L.ext
                L.ext   := high
                L.extBi := bar_index
            if low < L.ext2
                L.ext2   := low
                L.ext2Bi := bar_index
            if close < L.ext - thr
                array.push(L.pv, Piv.new(L.ext, L.extBi, true))
                confirmed := true
                L.dir   := -1
                L.ext   := low
                L.extBi := bar_index
            else if close > L.ext2 + thr
                array.push(L.pv, Piv.new(L.ext2, L.ext2Bi, false))
                confirmed := true
                L.dir   := 1
                L.ext   := high
                L.extBi := bar_index
    else if L.dir == 1
        if high > L.ext
            L.ext   := high
            L.extBi := bar_index
        if close < L.ext - thr
            array.push(L.pv, Piv.new(L.ext, L.extBi, true))
            confirmed := true
            L.dir   := -1
            L.ext   := low
            L.extBi := bar_index
    else
        if low < L.ext
            L.ext   := low
            L.extBi := bar_index
        if close > L.ext + thr
            array.push(L.pv, Piv.new(L.ext, L.extBi, false))
            confirmed := true
            L.dir   := 1
            L.ext   := high
            L.extBi := bar_index

    if array.size(L.pv) > 24
        array.shift(L.pv)

    // ZigZag 骨架（只为调阈值用，默认关）
    if confirmed and showZZ and array.size(L.pv) >= 2
        Piv q0 = array.get(L.pv, array.size(L.pv) - 2)
        Piv q1 = array.get(L.pv, array.size(L.pv) - 1)
        array.push(L.zz, line.new(q0.bi, q0.price, q1.bi, q1.price, xloc = xloc.bar_index,
             color = color.new(L.col, zzT), width = zzW))
        if array.size(L.zz) > 40
            line.delete(array.shift(L.zz))
    confirmed

// ───────────────────────────────────────────────────────── 3. 形态对象

// 只抹掉推演部分，浪线和 (1)..(5) 标签留着
delProj(Wave w) =>
    line.delete(w.proj)
    line.delete(w.ray)
    label.delete(w.projLb)

delWave(Wave w) =>
    if array.size(w.segs) > 0
        for i = 0 to array.size(w.segs) - 1
            line.delete(array.get(w.segs, i))
    if array.size(w.lbs) > 0
        for i = 0 to array.size(w.lbs) - 1
            label.delete(array.get(w.lbs, i))
    delProj(w)

// ───────────────────────────────────────────────────────── 4. 检测（换形态只改这一节）

// 最近 6 个交替枢轴 P0..P5：
//   看涨  低 高 低 高 低 高      浪1 = P0→P1 ... 浪5 = P4→P5
//   看跌  高 低 高 低 高 低      完全镜像
method detect(Lv L) =>
    bool found = false
    int n = array.size(L.pv)
    if n >= 6
        Piv p0 = array.get(L.pv, n - 6)
        Piv p1 = array.get(L.pv, n - 5)
        Piv p2 = array.get(L.pv, n - 4)
        Piv p3 = array.get(L.pv, n - 3)
        Piv p4 = array.get(L.pv, n - 2)
        Piv p5 = array.get(L.pv, n - 1)

        bool bull = not p0.isHigh and p1.isHigh and not p2.isHigh
                     and p3.isHigh and not p4.isHigh and p5.isHigh
        bool bear = p0.isHigh and not p1.isHigh and p2.isHigh
                     and not p3.isHigh and p4.isHigh and not p5.isHigh

        float l1 = math.abs(p1.price - p0.price)
        float l3 = math.abs(p3.price - p2.price)
        float l5 = math.abs(p5.price - p4.price)

        // 硬规则
        bool r2 = bull ? p2.price > p0.price : p2.price < p0.price   // 浪2 不跌破起点
        bool r3 = not (l3 < l1 and l3 < l5)                          // 浪3 不是最短
        // 浪4 不进浪1 区间。ovTol = 0 是严格版；放宽后允许侵入浪1 长度的 ovTol 倍
        float tol = l1 * ovTol
        bool r4 = bull ? p4.price > p1.price - tol : p4.price < p1.price + tol
        bool r5 = not need5 or (bull ? p5.price > p3.price : p5.price < p3.price)
        // 注：r4 + 交替性已经蕴含 P3 越过 P1，所以不用再单列一条

        // rBi：六个点必须落在**六根不同的**K线上。一根大阴/大阳线可以同时
        // 贡献摆动高点和摆动低点，那会让某一浪变成零长度的垂直线段 ——
        // 实测 SOL 日线 ATR×2 的两组命中**全部**是这种。
        bool rBi = p1.bi > p0.bi and p2.bi > p1.bi and p3.bi > p2.bi
                     and p4.bi > p3.bi and p5.bi > p4.bi
        // rSpan：跨度上限，见输入里的说明
        bool rSpan = maxSpan == 0 or (p5.bi - p0.bi) <= maxSpan

        if (bull or bear) and r2 and r3 and r4 and r5 and rBi and rSpan
            found := true
            L.hits := L.hits + 1
            L.lastDir := bull ? 1 : -1
            bool star = fibOn and l3 >= fibN * l1
            int  wThick = star ? L.wid + starW : L.wid

            // 只留最新一组推演：上一组的斜线/射线/标签在这里抹掉，
            // 浪线本身保留（那是已经发生过的事实，不是预测）
            if projLast and array.size(L.ws) > 0
                delProj(array.get(L.ws, array.size(L.ws) - 1))

            Wave w = Wave.new(segs = array.new<line>(), lbs = array.new<label>(),
                 expired = false)

            // P0→P5 连线，浪3 达标时加粗
            array.push(w.segs, line.new(p0.bi, p0.price, p1.bi, p1.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))
            array.push(w.segs, line.new(p1.bi, p1.price, p2.bi, p2.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))
            array.push(w.segs, line.new(p2.bi, p2.price, p3.bi, p3.price,
                 xloc = xloc.bar_index, color = L.col, width = wThick))
            array.push(w.segs, line.new(p3.bi, p3.price, p4.bi, p4.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))
            array.push(w.segs, line.new(p4.bi, p4.price, p5.bi, p5.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))

            for k = 1 to 5
                Piv q = array.get(L.pv, n - 6 + k)
                string txt = "(" + str.tostring(k) + ")" + (k == 3 and star ? " ★" : "")
                array.push(w.lbs, label.new(q.bi, q.price, txt, xloc = xloc.bar_index,
                     style = q.isHigh ? label.style_label_down : label.style_label_up,
                     color = color.new(L.col, 25), textcolor = color.white, size = szLbl))

            // 推演：1-5 走完接 ABC 调整，按回撤比例给一个目标价 + 大致耗时
            if showProj
                int span  = math.max(1, p5.bi - p0.bi)
                int dbars = math.max(1, int(math.round(span * projTime)))
                // 450 是留给 TradingView 的未来绘图上限（最多 500 根）
                int tgtBi = math.min(p5.bi + dbars, bar_index + 450)
                float full = math.abs(p5.price - p0.price)
                float tgt  = bull ? p5.price - full * projRetr : p5.price + full * projRetr
                w.tgtBi := tgtBi
                w.tgtPx := tgt

                // 斜线：从 P5 指向目标，用**自己的颜色**（和三个级别都不同），
                // 否则它和浪线一个色一个形状，在图上根本认不出来
                w.proj := line.new(p5.bi, p5.price, tgtBi, tgt, xloc = xloc.bar_index,
                     color = pCol, style = stPrj, width = pWidth)

                // 水平射线：斜线只说「往那边走」，这条才让目标价可读
                if projRay
                    w.ray := line.new(p5.bi, tgt, bar_index + 1, tgt, xloc = xloc.bar_index,
                         color = color.new(pCol, 45), style = line.style_dotted,
                         width = 1, extend = extend.right)

                w.projLb := label.new(tgtBi, tgt,
                     L.name + (bull ? " ↓调整 " : " ↑调整 ") + str.tostring(tgt, format.mintick)
                     + "  (" + str.tostring(projRetr) + ")",
                     xloc = xloc.bar_index,
                     style = bull ? label.style_label_up : label.style_label_down,
                     color = color.new(pCol, 30), textcolor = color.white, size = szLbl)

            array.push(L.ws, w)
            if array.size(L.ws) > maxPat
                delWave(array.shift(L.ws))
    found

// 推演过期清理。推演在 P5 刚确认时指向未来，但它会一直挂在图上 ——
// 等价格走过 tgtBi 之后，那条斜线就变成一条画在旧K线上、对过去做的预测。
// 实测 SOL 日线：三个级别最新的推演分别已经过期 1010 / 514 / 222 根。
method sweep(Lv L) =>
    if array.size(L.ws) > 0
        for i = 0 to array.size(L.ws) - 1
            Wave w = array.get(L.ws, i)
            if not w.expired and not na(w.tgtBi) and bar_index > w.tgtBi
                w.expired := true
                delProj(w)

// 还没过期的推演目标价，给样式页那一层用（没有就是 na，plot 自动断开）
method activeTgt(Lv L) =>
    float t = na
    if array.size(L.ws) > 0
        for i = 0 to array.size(L.ws) - 1
            Wave w = array.get(L.ws, i)
            if not w.expired and not na(w.tgtPx)
                t := w.tgtPx
    t

// ── 待定推演 ────────────────────────────────────────────────────────────
// 正式推演要等 6 个枢轴全确认。在那之前，只要前 5 个点已经构成一个合规的
// 浪1-4 前缀、而且当前正在往浪5 的方向走，就先假设一条。
//
// 只在最后一根上画（barstate.islast）：待定线本来就只在「现在」有意义，
// 而且每根都重画的话，历史上会产生几万次对象增删。
//
// 它**每根都会变**。实时极值一动，假设的 P5 就动，目标也跟着动。用点线 +
// 另一种颜色 + 标签写「待定」，就是为了不让它被误当成已确认的东西。
//
// 顺带把「现在卡在哪一条」写进 L.note，状态表直接显示 —— 省得再问一次
// 「为什么没有线」。
method tentative(Lv L) =>
    line.delete(L.tW5)
    line.delete(L.tAB)
    line.delete(L.tRay)
    label.delete(L.tLb)
    L.note := ""

    int n = array.size(L.pv)
    // 已经有正式推演挂在图上就不画待定 —— 否则两条线会打架。
    // （6 个点确认之后，「最近 5 个点」正好是 P1..P5，方向反过来，
    //   会被误读成一个反向的浪1-4 前缀。）
    if not na(L.activeTgt())
        L.note := "正式推演进行中"
    else if n < 5
        L.note := "枢轴不足 " + str.tostring(n) + "/5"
    else
        Piv p0 = array.get(L.pv, n - 5)
        Piv p1 = array.get(L.pv, n - 4)
        Piv p2 = array.get(L.pv, n - 3)
        Piv p3 = array.get(L.pv, n - 2)
        Piv p4 = array.get(L.pv, n - 1)

        bool bull = not p0.isHigh and p1.isHigh and not p2.isHigh
                     and p3.isHigh and not p4.isHigh
        bool bear = p0.isHigh and not p1.isHigh and p2.isHigh
                     and not p3.isHigh and p4.isHigh
        // 当前这条未确认的腿，方向必须和浪5 一致
        bool inW5 = (bull and L.dir == 1) or (bear and L.dir == -1)

        float l1 = math.abs(p1.price - p0.price)
        float l3 = math.abs(p3.price - p2.price)
        bool k2  = bull ? p2.price > p0.price : p2.price < p0.price
        bool k4  = bull ? p4.price > p1.price - l1 * ovTol : p4.price < p1.price + l1 * ovTol
        bool kBi = p1.bi > p0.bi and p2.bi > p1.bi and p3.bi > p2.bi and p4.bi > p3.bi
        bool kSp = maxSpan == 0 or (bar_index - p0.bi) <= maxSpan

        if not (bull or bear)
            L.note := "枢轴不交替"
        else if not kBi
            L.note := "有两点同根K线"
        else if not k2
            L.note := "浪2 跌破起点"
        else if not k4
            float ov = bull ? (p1.price - p4.price) / l1 : (p4.price - p1.price) / l1
            L.note := "浪4 重叠浪1 " + str.tostring(ov * 100, "#.#") + "%"
        else if not kSp
            L.note := "跨度 " + str.tostring(bar_index - p0.bi) + " 超限"
        else if not inW5
            L.note := "不在浪5 方向"
        else
            // 预期浪5 终点：P4 ± 浪1 × fib5，再用两条硬规则夹紧
            float p5h = bull ? p4.price + l1 * fib5 : p4.price - l1 * fib5
            // 夹紧①：浪3 比浪1 短的时候，浪5 不能超过浪3，
            //         否则「浪3 不是最短」会被这条假设自己破坏
            if l3 < l1
                if bull
                    p5h := math.min(p5h, p4.price + l3)
                else
                    p5h := math.max(p5h, p4.price - l3)
            // 夹紧②：浪5 必须超越浪3 端点（如果那条开着）
            if need5
                if bull
                    p5h := math.max(p5h, p3.price + syminfo.mintick)
                else
                    p5h := math.min(p5h, p3.price - syminfo.mintick)
            // 夹紧③：实际已经走过假设终点的话，用实时极值 —— 浪5 在延伸
            if bull
                p5h := math.max(p5h, L.ext)
            else
                p5h := math.min(p5h, L.ext)

            // 时间：浪5 大致和浪1 等长（教科书指引），至少落在当前 bar 之后
            int dur1 = math.max(1, p1.bi - p0.bi)
            int p5bi = math.min(math.max(bar_index + 1, p4.bi + dur1), bar_index + 300)

            float full = math.abs(p5h - p0.price)
            float tgt  = bull ? p5h - full * projRetr : p5h + full * projRetr
            int span2  = math.max(1, p5bi - p0.bi)
            int tbi    = math.min(p5bi + math.max(1, int(math.round(span2 * projTime))),
                 bar_index + 450)

            L.tW5 := line.new(p4.bi, p4.price, p5bi, p5h, xloc = xloc.bar_index,
                 color = tCol, style = line.style_dotted, width = tWidth)
            L.tAB := line.new(p5bi, p5h, tbi, tgt, xloc = xloc.bar_index,
                 color = tCol, style = line.style_dotted, width = tWidth)
            if projRay
                L.tRay := line.new(p5bi, tgt, bar_index + 1, tgt, xloc = xloc.bar_index,
                     color = color.new(tCol, 60), style = line.style_dotted, width = 1,
                     extend = extend.right)
            L.tLb := label.new(tbi, tgt,
                 L.name + " 待定 " + str.tostring(tgt, format.mintick)
                 + "   浪5→" + str.tostring(p5h, format.mintick),
                 xloc = xloc.bar_index,
                 style = bull ? label.style_label_up : label.style_label_down,
                 color = color.new(tCol, 25), textcolor = color.white, size = szLbl)
            L.note := (bull ? "待定 ↑" : "待定 ↓") + " 浪5 进行中"

// ───────────────────────────────────────────────────────── 5. 每根维护

// 输入可能被改；每根同步回对象，免得改了参数不生效
LA.mult := mA
LA.col  := cA
LA.wid  := wA
LA.on   := onA
LB.mult := mB
LB.col  := cB
LB.wid  := wB
LB.on   := onB
LC.mult := mC
LC.col  := cC
LC.wid  := wC
LC.on   := onC

bool hitA = false
bool hitB = false
bool hitC = false

if LA.on and atrOk and LA.zigzag(atrV * LA.mult)
    hitA := LA.detect()
if LB.on and atrOk and LB.zigzag(atrV * LB.mult)
    hitB := LB.detect()
if LC.on and atrOk and LC.zigzag(atrV * LC.mult)
    hitC := LC.detect()

// 过期清理每根都要跑，不能挂在「本根确认了新枢轴」上
LA.sweep()
LB.sweep()
LC.sweep()

// 待定推演只在最后一根上画（它只在「现在」有意义）
if tentOn and barstate.islast
    if LA.on
        LA.tentative()
    if LB.on
        LB.tentative()
    if LC.on
        LC.tentative()

// 样式页那一层要用的序列
float tgtA = LA.on ? LA.activeTgt() : na
float tgtB = LB.on ? LB.activeTgt() : na
float tgtC = LC.on ? LC.activeTgt() : na
bool  wvBull = (hitA and LA.lastDir > 0) or (hitB and LB.lastDir > 0) or (hitC and LC.lastDir > 0)
bool  wvBear = (hitA and LA.lastDir < 0) or (hitB and LB.lastDir < 0) or (hitC and LC.lastDir < 0)

if showTbl and barstate.islast
    // 三列：级别 / 阈值·命中 / **现在卡在哪一条**。第三列是重点 ——
    // 「为什么没有推演线」直接写在图上，不用再去猜。
    var table tb = table.new(position.bottom_right, 3, 5,
         bgcolor = color.new(color.black, 20), border_width = 1,
         border_color = color.new(color.gray, 60))
    table.cell(tb, 0, 0, "级别",       text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 0, "阈值 · 命中", text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 2, 0, "当前状态",   text_color = color.silver, text_size = size.tiny)

    table.cell(tb, 0, 1, "A", text_color = cA, text_size = size.tiny)
    table.cell(tb, 1, 1, LA.on ? "ATR×" + str.tostring(mA) + " · " + str.tostring(LA.hits) : "关",
         text_color = cA, text_size = size.tiny)
    table.cell(tb, 2, 1, LA.on ? LA.note : "", text_color = cA, text_size = size.tiny)

    table.cell(tb, 0, 2, "B", text_color = cB, text_size = size.tiny)
    table.cell(tb, 1, 2, LB.on ? "ATR×" + str.tostring(mB) + " · " + str.tostring(LB.hits) : "关",
         text_color = cB, text_size = size.tiny)
    table.cell(tb, 2, 2, LB.on ? LB.note : "", text_color = cB, text_size = size.tiny)

    table.cell(tb, 0, 3, "C", text_color = cC, text_size = size.tiny)
    table.cell(tb, 1, 3, LC.on ? "ATR×" + str.tostring(mC) + " · " + str.tostring(LC.hits) : "关",
         text_color = cC, text_size = size.tiny)
    table.cell(tb, 2, 3, LC.on ? LC.note : "", text_color = cC, text_size = size.tiny)

    table.cell(tb, 0, 4, "⚠", text_color = color.orange, text_size = size.tiny)
    table.cell(tb, 1, 4, "待定线每根都变", text_color = color.orange, text_size = size.tiny)
    table.cell(tb, 2, 4, "最新一浪会重绘；加载更多历史后数浪可能整体改变",
         text_color = color.orange, text_size = size.tiny)

// ───────────────────────────────────────────────────────── 6. 警报

alertcondition(hitA or hitB or hitC, "推动浪成立（任意级别）", "1-2-3-4-5 推动浪校验通过")
alertcondition(hitA, "推动浪成立 · 级别A", "级别 A（ATR×小倍数）出现 1-2-3-4-5")
alertcondition(hitB, "推动浪成立 · 级别B", "级别 B 出现 1-2-3-4-5")
alertcondition(hitC, "推动浪成立 · 级别C", "级别 C（ATR×大倍数）出现 1-2-3-4-5")

// ───────────────────────────────────────────────────────── 7. 样式页输出
//
// TradingView 的「样式」标签页只收 plot 家族的输出（plot / plotshape /
// plotchar / fill / bgcolor / hline）。line、label、box 这类绘图对象永远
// 进不了样式页 —— 那是 TradingView 的设计，不是这份脚本的取舍。浪线和推演
// 斜线必须是绘图对象（它们连接的是任意两根 bar），所以那部分的颜色线宽只能
// 在输入页第 ④ 组调；下面这些是能进样式页的部分。
//
// 三条目标价线用 style_linebr：推演过期之后值变 na，线**自动断开**，
// 不会像原来那样拖一条横穿图表的假线。

plot(tgtA, "级别A 推演目标价", color = #42a5f5, linewidth = 1,
     style = plot.style_linebr, display = display.pane)
plot(tgtB, "级别B 推演目标价", color = #ab47bc, linewidth = 1,
     style = plot.style_linebr, display = display.pane)
plot(tgtC, "级别C 推演目标价", color = #ffa726, linewidth = 1,
     style = plot.style_linebr, display = display.pane)

plotshape(wvBull, "事件 · 看涨推动浪成立", shape.triangleup, location.belowbar,
     color = #26a69a, size = size.small)
plotshape(wvBear, "事件 · 看跌推动浪成立", shape.triangledown, location.abovebar,
     color = #ef5350, size = size.small)
