//@version=6
// =============================================================================
// 推动浪 1-2-3-4-5  —  多级别 ZigZag + 艾略特规则 + 全周期场景推演
// =============================================================================
// 骨架：①输入 → ②枢轴序列 → ③已确认的浪 → ④检测 → ⑤场景推演 → ⑥每根维护
//       → ⑦警报 → ⑧样式页
//
// 两件事分开做：
//
//   检测（④）  历史上**已经走完**的 1-2-3-4-5，画实线 + (1)..(5) 标签。
//              硬规则：浪2 不破起点 / 浪3 不最短 / 浪4 不进浪1 /（可选）浪5 越过浪3。
//
//   推演（⑤）  **现在**处在艾略特周期 1-2-3-4-5-A-B-C 的哪一浪，从现在往后画几段。
//              旧版只认得「正在走浪5」这一个位置，另外七个位置什么都不画 ——
//              实测只有 0–28% 的时间画得出推演。新版对八个位置逐一检验，取能解释
//              最多枢轴的那个。实测 BTC/ETH/SOL × 周/日/4h × 三个级别、1620 个
//              抽样点：99.2% 画得出，剩下的都是「图上枢轴还不到 2 个」。
//
// 推演的高度和角度各有依据：
//
//   高度  每一浪的终点按艾略特常用斐波那契关系（全部可在 ③ 组调）：
//           浪2 回撤浪1 0.618   浪3 = 1.618 × 浪1   浪4 回撤浪3 0.382
//           浪5 = 1.0 × 浪1     ABC 合计回撤推动浪 0.5（B 回撤 A 0.618，C = A）
//         再用硬规则夹紧：浪4 不进浪1、浪5 越过浪3、浪3 不最短、B 不越过浪5 ……
//
//   角度  每条腿的耗时 = 价格长度 ÷ 同类腿的实测速度。推动腿（1/3/5/A/C）和
//         调整腿（2/4/B）分开算：本组已走完的腿各算一票，本级别最近 10 条腿的
//         中位数也算一票（只有一条腿可参考时，不至于被它带偏）。
//         所以推出来的浪3 和实测的浪1 一样陡，浪4 和实测的浪2 一样缓。
//
// 正在走的那一浪有三种情况：
//   没到目标           从「现在」画到目标
//   越过目标、还在走   取下一档延长目标（浪3 1.618→2.618、浪5 1.0→1.618 ……）
//   越过目标、已回头   暂按「这一浪在极值处走完」处理，从极值处接下一浪，标签带「?」
//
// ⚠ 推演只在最后一根上画，**每根都会重算**。ZigZag 是路径依赖的，加载更多历史
//   后整串枢轴可能挪位。推演是规则的机械推论，不是信号。
// =============================================================================

indicator("推动浪 1-2-3-4-5 多级别", "Impulse 1-5", overlay = true,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// ───────────────────────────────────────────────────────── 1. 输入

gZ = "① ZigZag（ATR 反转阈值）"
tfAuto = input.bool(true, "阈值按周期自动缩放（推荐）", group = gZ,
     tooltip = "**打开之后下面三个手动值不生效。**\n\n" +
               "阈值是 ATR 倍数，幅度上跨周期自适应，但**枢轴数量不会** —— 枢轴数取决于" +
               "图上有多少根K线。实测 ETH：日线 1713 根，ATR×2/×4/×8 给出 114/42/15 个枢轴；" +
               "周线只有 246 根，同样的倍数只给出 14/7/**3** 个。\n\n" +
               "自动模式按图表周期选：\n" +
               "  月线      0.25 / 0.5 / 0.75\n" +
               "  周线      0.5  / 1.0 / 1.5\n" +
               "  日线·4h   2    / 4   / 8\n" +
               "  4h 以下   3    / 6   / 12\n\n" +
               "状态表第二列显示的是**实际生效**的倍数。")
atrLen = input.int(14, "ATR 周期", minval = 1, group = gZ)
mA = input.float(2.0, "手动：级别「细」阈值 = ATR ×", minval = 0.1, step = 0.1, group = gZ)
mB = input.float(4.0, "手动：级别「中」阈值 = ATR ×", minval = 0.1, step = 0.1, group = gZ)
mC = input.float(8.0, "手动：级别「粗」阈值 = ATR ×", minval = 0.1, step = 0.1, group = gZ)
onA = input.bool(true,  "启用级别「细」", group = gZ)
onB = input.bool(true,  "启用级别「中」", group = gZ)
onC = input.bool(false, "启用级别「粗」", group = gZ,
     tooltip = "级别原来叫 A / B / C，现在改叫 细 / 中 / 粗 —— 因为推演会画出调整浪 A、B、C，" +
               "「B 级别的 A 浪」这种标签没法读。")

// 按图表周期挑倍数。分档依据是「多少根K线」，不是「多大幅度」
tfSec = timeframe.in_seconds()
autoA = tfSec >= 2592000 ? 0.25 : tfSec >= 604800 ? 0.5 : tfSec >= 14400 ? 2.0 : 3.0
autoB = tfSec >= 2592000 ? 0.50 : tfSec >= 604800 ? 1.0 : tfSec >= 14400 ? 4.0 : 6.0
autoC = tfSec >= 2592000 ? 0.75 : tfSec >= 604800 ? 1.5 : tfSec >= 14400 ? 8.0 : 12.0
useA = tfAuto ? autoA : mA
useB = tfAuto ? autoB : mB
useC = tfAuto ? autoC : mC

gR = "② 校验规则"
need5 = input.bool(true, "浪5 必须超越浪3 端点", group = gR,
     tooltip = "关掉 = 允许衰竭浪（truncated fifth）。三条硬规则之外加的第四条，" +
               "衰竭浪在艾略特里合法但少见，默认打开能少掉很多噪声数浪。")
ovTol = input.float(0.0, "浪4 允许重叠浪1 的比例", minval = 0.0, maxval = 0.5, step = 0.01, group = gR,
     tooltip = "「浪4 不进浪1 价格区间」是艾略特最硬的一条，默认 0 = 一点都不让。" +
               "对角线形态（leading / ending diagonal）允许重叠，所以给一个容差，" +
               "单位是浪1 长度的比例。**调这个值是在放宽定义，不是在改进检测。**")
fibOn = input.bool(true,  "浪3 ≥ N×浪1 时加粗标 ★（仅加分）", group = gR)
fibN  = input.float(1.618, "加分比例 N", minval = 0.5, step = 0.1, group = gR)
maxPat = input.int(1, "每个级别保留最近几组", minval = 1, maxval = 8, group = gR)
maxSpan = input.int(300, "一组浪最大跨度（根，0 = 不限）", minval = 0, group = gR,
     tooltip = "浪线是两个枢轴之间的直线；枢轴隔了几百根的时候两端都在屏幕外，" +
               "中间那条直线会横穿图表、落在和当地K线无关的价位上。")

gP = "③ 场景推演"
showProj = input.bool(true, "画场景推演", group = gP,
     tooltip = "判断**现在**处在艾略特周期 1-2-3-4-5-A-B-C 的哪一浪，从现在往后画几段。\n\n" +
               "八个位置逐一检验，取能解释最多枢轴的那个；一个都不成立时，退回到" +
               "「新的一浪1 正在走」—— 所以只要图上有 2 个以上枢轴，就一定画得出来。\n\n" +
               "**每根都会重算。这是规则的机械推论，不是信号。**")
projLegs = input.int(4, "往后推几段", minval = 1, maxval = 6, group = gP)
ret2 = input.float(0.618, "高度 · 浪2 回撤浪1", minval = 0.1, maxval = 0.99, step = 0.01, group = gP)
fib3 = input.float(1.618, "高度 · 浪3 = 浪1 ×", minval = 1.0, maxval = 4.236, step = 0.1, group = gP)
ret4 = input.float(0.382, "高度 · 浪4 回撤浪3", minval = 0.1, maxval = 0.9, step = 0.01, group = gP)
fib5 = input.float(1.0, "高度 · 浪5 = 浪1 ×", minval = 0.382, maxval = 3.0, step = 0.1, group = gP,
     tooltip = "浪3 延长时，「浪5 = 浪1」可能连浪3 的高点都过不去；这时自动改用另一条常用指引：" +
               "浪5 = 0.618 × (浪1 起点 → 浪3 终点)。")
projRetr = input.float(0.5, "高度 · ABC 合计回撤推动浪", minval = 0.1, maxval = 1.0, step = 0.05, group = gP,
     tooltip = "C 的终点 = 浪5 终点回撤 (1-5 全长) × 这个比例。\n" +
               "A、B、C 的分配按最常见的锯齿形：B 回撤 A 下面那个比例，C = A。")
retB = input.float(0.618, "高度 · B 回撤 A", minval = 0.1, maxval = 0.99, step = 0.01, group = gP)
projRay = input.bool(true, "在推演终点价画水平射线", group = gP)

gS = "④ 样式"
// TradingView 的「样式」标签页只收 plot/plotshape 这类输出，line/label/box 这种
// 绘图对象改不了颜色线宽 —— 所以放在输入页这一组。
cA = input.color(#42a5f5, "级别「细」颜色", group = gS, inline = "A")
wA = input.int(2, "线宽", minval = 1, maxval = 6, group = gS, inline = "A")
cB = input.color(#ab47bc, "级别「中」颜色", group = gS, inline = "B")
wB = input.int(2, "线宽", minval = 1, maxval = 6, group = gS, inline = "B")
cC = input.color(#ffa726, "级别「粗」颜色", group = gS, inline = "C")
wC = input.int(2, "线宽", minval = 1, maxval = 6, group = gS, inline = "C")
starW   = input.int(2, "浪3 达标时额外加粗", minval = 0, maxval = 4, group = gS)
lblSize = input.string("tiny", "图上标签大小", options = ["tiny", "small", "normal"], group = gS)
pWidth  = input.int(2, "推演线 线宽", minval = 1, maxval = 6, group = gS, inline = "P")
pStyle  = input.string("虚线", "样式", options = ["虚线", "点线", "实线"], group = gS, inline = "P")
showZZ  = input.bool(false, "画出 ZigZag 骨架（调阈值时打开）", group = gS, inline = "Z")
zzW     = input.int(1, "线宽", minval = 1, maxval = 4, group = gS, inline = "Z")
zzT     = input.int(55, "透明度", minval = 0, maxval = 100, group = gS, inline = "Z")
showTbl = input.bool(true, "右下角状态表", group = gS, inline = "TB")
tblSz   = input.string("中", "字号", options = ["小", "中", "大", "特大"], group = gS, inline = "TB")

// ATR 前 atrLen 根是 na。兜底成 10 个 tick 会让阈值近乎为零、开头几根疯狂确认枢轴，
// 所以宁可等 ATR 有效再开始滚。
atrRaw = ta.atr(atrLen)
atrOk  = not na(atrRaw)
atrV   = nz(atrRaw, syminfo.mintick * 10.0)

szLbl = lblSize == "normal" ? size.normal : lblSize == "small" ? size.small : size.tiny
szT   = tblSz == "特大" ? size.huge : tblSz == "大" ? size.large : tblSz == "小" ? size.small : size.normal
stPrj = pStyle == "实线" ? line.style_solid : pStyle == "点线" ? line.style_dotted : line.style_dashed

// ───────────────────────────────────────────────────────── 2. 枢轴序列

type Piv
    float price
    int   bi
    bool  isHigh

// 一组已确认的 1-5（历史记录）
type Wave
    array<line>  segs
    array<label> lbs
    bool  bull
    float p5px       // 浪5 终点价：收盘越过它 = 这组浪其实没走完，调整目标作废
    float tgtPx      // ABC 调整目标（样式页那条线用）
    bool  expired

type Lv
    string       name
    float        mult
    color        col
    int          wid
    bool         on
    int          dir      // +1 = 正在跟踪上升腿（找高点）, −1 = 下降腿, 0 = 还没定
    float        ext      // 当前腿的极值（播种期 = 跟踪中的高点）
    int          extBi
    float        ext2     // 只在播种期用：跟踪中的低点
    int          ext2Bi
    array<Piv>   pv
    array<Wave>  ws
    array<line>  zz
    int          hits
    int          lastDir  // 最近一次命中的方向：+1 看涨, −1 看跌
    int          pvTotal  // 累计确认的枢轴数。L.pv 只保留最近 24 个，不能拿来显示
    array<line>  sL       // 场景推演：折线
    array<label> sB       // 场景推演：各点标签
    line         sRay     // 场景推演：终点价水平射线
    int          sK       // 场景推演选中的位置（跨级别去重用）
    int          sP0      // 场景推演的起点枢轴所在 bar（跨级别去重用）
    string       note     // 状态表：当前位置
    string       note2    // 状态表：推演终点

var Lv LA = Lv.new(name = "细", mult = useA, col = cA, wid = wA, on = onA, dir = 0,
     ext = na, extBi = na, ext2 = na, ext2Bi = na,
     pv = array.new<Piv>(), ws = array.new<Wave>(), zz = array.new<line>(),
     hits = 0, lastDir = 0, pvTotal = 0,
     sL = array.new<line>(), sB = array.new<label>(), sK = -1, sP0 = -1, note = "", note2 = "")
var Lv LB = Lv.new(name = "中", mult = useB, col = cB, wid = wB, on = onB, dir = 0,
     ext = na, extBi = na, ext2 = na, ext2Bi = na,
     pv = array.new<Piv>(), ws = array.new<Wave>(), zz = array.new<line>(),
     hits = 0, lastDir = 0, pvTotal = 0,
     sL = array.new<line>(), sB = array.new<label>(), sK = -1, sP0 = -1, note = "", note2 = "")
var Lv LC = Lv.new(name = "粗", mult = useC, col = cC, wid = wC, on = onC, dir = 0,
     ext = na, extBi = na, ext2 = na, ext2Bi = na,
     pv = array.new<Piv>(), ws = array.new<Wave>(), zz = array.new<line>(),
     hits = 0, lastDir = 0, pvTotal = 0,
     sL = array.new<line>(), sB = array.new<label>(), sK = -1, sP0 = -1, note = "", note2 = "")

// ZigZag 单步。返回：本根是否**确认**了一个新枢轴。
// 确认条件是收盘价从当前腿的极值反向走出 thr —— 收盘才算，所以枢轴一旦确认
// 就不会被后来的行情抹掉（极值点本身在过去，不需要未来数据）。
method zigzag(Lv L, float thr) =>
    bool confirmed = false

    if L.dir == 0
        // 播种期：**同时**跟踪最高和最低，谁先反向走出 thr 谁定方向。
        if na(L.ext)
            L.ext    := high
            L.extBi  := bar_index
            L.ext2   := low
            L.ext2Bi := bar_index
        else
            if high > L.ext
                L.ext   := high
                L.extBi := bar_index
            if low < L.ext2
                L.ext2   := low
                L.ext2Bi := bar_index
            if close < L.ext - thr
                array.push(L.pv, Piv.new(L.ext, L.extBi, true))
                confirmed := true
                L.dir   := -1
                L.ext   := low
                L.extBi := bar_index
            else if close > L.ext2 + thr
                array.push(L.pv, Piv.new(L.ext2, L.ext2Bi, false))
                confirmed := true
                L.dir   := 1
                L.ext   := high
                L.extBi := bar_index
    else if L.dir == 1
        if high > L.ext
            L.ext   := high
            L.extBi := bar_index
        if close < L.ext - thr
            array.push(L.pv, Piv.new(L.ext, L.extBi, true))
            confirmed := true
            L.dir   := -1
            L.ext   := low
            L.extBi := bar_index
    else
        if low < L.ext
            L.ext   := low
            L.extBi := bar_index
        if close > L.ext + thr
            array.push(L.pv, Piv.new(L.ext, L.extBi, false))
            confirmed := true
            L.dir   := 1
            L.ext   := high
            L.extBi := bar_index

    if confirmed
        L.pvTotal := L.pvTotal + 1
    if array.size(L.pv) > 24
        array.shift(L.pv)

    // ZigZag 骨架（只为调阈值用，默认关）
    if confirmed and showZZ and array.size(L.pv) >= 2
        Piv q0 = array.get(L.pv, array.size(L.pv) - 2)
        Piv q1 = array.get(L.pv, array.size(L.pv) - 1)
        array.push(L.zz, line.new(q0.bi, q0.price, q1.bi, q1.price, xloc = xloc.bar_index,
             color = color.new(L.col, zzT), width = zzW))
        if array.size(L.zz) > 40
            line.delete(array.shift(L.zz))
    confirmed

// ───────────────────────────────────────────────────────── 3. 已确认的浪

delWave(Wave w) =>
    if array.size(w.segs) > 0
        for i = 0 to array.size(w.segs) - 1
            line.delete(array.get(w.segs, i))
    if array.size(w.lbs) > 0
        for i = 0 to array.size(w.lbs) - 1
            label.delete(array.get(w.lbs, i))

// ───────────────────────────────────────────────────────── 4. 检测（历史上已走完的 1-5）

// 最近 6 个交替枢轴 P0..P5：
//   看涨  低 高 低 高 低 高      浪1 = P0→P1 ... 浪5 = P4→P5
//   看跌  高 低 高 低 高 低      完全镜像
method detect(Lv L) =>
    bool found = false
    int n = array.size(L.pv)
    if n >= 6
        Piv p0 = array.get(L.pv, n - 6)
        Piv p1 = array.get(L.pv, n - 5)
        Piv p2 = array.get(L.pv, n - 4)
        Piv p3 = array.get(L.pv, n - 3)
        Piv p4 = array.get(L.pv, n - 2)
        Piv p5 = array.get(L.pv, n - 1)

        bool bull = not p0.isHigh and p1.isHigh and not p2.isHigh
                     and p3.isHigh and not p4.isHigh and p5.isHigh
        bool bear = p0.isHigh and not p1.isHigh and p2.isHigh
                     and not p3.isHigh and p4.isHigh and not p5.isHigh

        float l1 = math.abs(p1.price - p0.price)
        float l3 = math.abs(p3.price - p2.price)
        float l5 = math.abs(p5.price - p4.price)

        bool r2 = bull ? p2.price > p0.price : p2.price < p0.price   // 浪2 不跌破起点
        bool r3 = not (l3 < l1 and l3 < l5)                          // 浪3 不是最短
        float tol = l1 * ovTol
        bool r4 = bull ? p4.price > p1.price - tol : p4.price < p1.price + tol   // 浪4 不进浪1
        bool r5 = not need5 or (bull ? p5.price > p3.price : p5.price < p3.price)
        // 六个点必须落在六根不同的K线上（一根大K线可以同时贡献高点和低点）
        bool rBi = p1.bi > p0.bi and p2.bi > p1.bi and p3.bi > p2.bi
                     and p4.bi > p3.bi and p5.bi > p4.bi
        bool rSpan = maxSpan == 0 or (p5.bi - p0.bi) <= maxSpan

        if (bull or bear) and r2 and r3 and r4 and r5 and rBi and rSpan
            found := true
            L.hits := L.hits + 1
            L.lastDir := bull ? 1 : -1
            bool star = fibOn and l3 >= fibN * l1
            int  wThick = star ? L.wid + starW : L.wid

            // 新的一组确认之后，旧的那组的调整目标就作废了
            if array.size(L.ws) > 0
                for i = 0 to array.size(L.ws) - 1
                    Wave wo = array.get(L.ws, i)
                    wo.expired := true

            float full = math.abs(p5.price - p0.price)
            Wave w = Wave.new(segs = array.new<line>(), lbs = array.new<label>(),
                 bull = bull, p5px = p5.price,
                 tgtPx = bull ? p5.price - full * projRetr : p5.price + full * projRetr,
                 expired = false)

            array.push(w.segs, line.new(p0.bi, p0.price, p1.bi, p1.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))
            array.push(w.segs, line.new(p1.bi, p1.price, p2.bi, p2.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))
            array.push(w.segs, line.new(p2.bi, p2.price, p3.bi, p3.price,
                 xloc = xloc.bar_index, color = L.col, width = wThick))
            array.push(w.segs, line.new(p3.bi, p3.price, p4.bi, p4.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))
            array.push(w.segs, line.new(p4.bi, p4.price, p5.bi, p5.price,
                 xloc = xloc.bar_index, color = L.col, width = L.wid))

            for k = 1 to 5
                Piv q = array.get(L.pv, n - 6 + k)
                string txt = "(" + str.tostring(k) + ")" + (k == 3 and star ? " ★" : "")
                array.push(w.lbs, label.new(q.bi, q.price, txt, xloc = xloc.bar_index,
                     style = q.isHigh ? label.style_label_down : label.style_label_up,
                     color = color.new(L.col, 25), textcolor = color.white, size = szLbl))

            array.push(L.ws, w)
            if array.size(L.ws) > maxPat
                delWave(array.shift(L.ws))
    found

// 已确认那组的调整目标什么时候作废：价格**到达**目标（兑现了），或者收盘**越过浪5
// 终点**（说明浪5 其实没走完）。旧版按时间过期，和价格无关，不合逻辑。
method sweep(Lv L) =>
    if array.size(L.ws) > 0
        for i = 0 to array.size(L.ws) - 1
            Wave w = array.get(L.ws, i)
            if not w.expired and not na(w.tgtPx)
                bool hit   = w.bull ? low <= w.tgtPx : high >= w.tgtPx
                bool inval = w.bull ? close > w.p5px : close < w.p5px
                if hit or inval
                    w.expired := true

method activeTgt(Lv L) =>
    float t = na
    if array.size(L.ws) > 0
        for i = 0 to array.size(L.ws) - 1
            Wave w = array.get(L.ws, i)
            if not w.expired and not na(w.tgtPx)
                t := w.tgtPx
    t

// ───────────────────────────────────────────────────────── 5. 场景推演
//
// 周期里的第 j 段：0..7 = 1 2 3 4 5 A B C，8..9 = 下一轮的 1 2。
// 所有计算在「归一化」价格上做：x = s × price，s = 看涨 +1 / 看跌 −1。
// 这样推动方向永远是「向上」，看涨看跌共用同一套公式和比较方向。

scName(int j) =>
    j == 0 ? "(1)" : j == 1 ? "(2)" : j == 2 ? "(3)" : j == 3 ? "(4)" : j == 4 ? "(5)" : j == 5 ? "A" : j == 6 ? "B" : j == 7 ? "C" : j == 8 ? "(1)′" : "(2)′"

// 推动型的腿（1 3 5 A C 和下一轮的 1），和调整型的腿（2 4 B）分开算速度
scImp(int j) =>
    j == 0 or j == 2 or j == 4 or j == 5 or j == 7 or j == 8

// 「现在正在走第 k 段」这个解读成立吗？
// 要求：最近 k+1 个枢轴能当作 P0..Pk，方向交替、时间递增，走完的部分全部合规，
// 而且正在走的那一段已经走出来的部分也不违规。
scValid(Lv L, int k) =>
    int n = array.size(L.pv)
    Piv q0 = array.get(L.pv, n - 1 - k)
    bool bull = not q0.isHigh
    float s = bull ? 1.0 : -1.0
    bool ok = true
    array<float> x = array.new<float>()
    for i = 0 to k
        Piv qi = array.get(L.pv, n - 1 - k + i)
        array.push(x, s * qi.price)
        if qi.isHigh != ((i % 2 == 1) == bull)
            ok := false
        if i > 0
            Piv qp = array.get(L.pv, n - 2 - k + i)
            if qi.bi <= qp.bi
                ok := false
    float xe = s * L.ext
    if ok and k >= 1
        float l1 = array.get(x, 1) - array.get(x, 0)
        if maxSpan > 0 and bar_index - q0.bi > maxSpan
            ok := false
        if k >= 2
            if not (array.get(x, 2) > array.get(x, 0))                     // 浪2 不破起点
                ok := false
        if k >= 3
            if not (array.get(x, 3) > array.get(x, 1))                     // 浪3 越过浪1
                ok := false
        if k >= 4
            if not (array.get(x, 4) > array.get(x, 1) - ovTol * l1)       // 浪4 不进浪1
                ok := false
        if k >= 5
            float l3 = array.get(x, 3) - array.get(x, 2)
            float l5 = array.get(x, 5) - array.get(x, 4)
            if l3 < l1 and l3 < l5                                         // 浪3 不最短
                ok := false
            if need5
                if not (array.get(x, 5) > array.get(x, 3))                 // 浪5 越过浪3
                    ok := false
        if k >= 6
            if not (array.get(x, 6) > array.get(x, 0))                     // A 不破推动浪起点
                ok := false
        if k >= 7
            if not (array.get(x, 5) > array.get(x, 7))                     // B 不越过浪5
                ok := false
        // 正在走的那一段，已经走出来的部分也不能违规
        if k == 1
            if not (xe > array.get(x, 0))
                ok := false
        if k == 3
            if not (xe > array.get(x, 1) - ovTol * l1)
                ok := false
        if k == 5 or k == 7
            if not (xe > array.get(x, 0))
                ok := false
        if k == 6
            if not (array.get(x, 5) > xe)
                ok := false
    ok

// 第 j 段终点的斐波那契目标（归一化价格）。ext = true 时取下一档延长目标。
scTgt(array<float> E, float x0, int j, bool ext, float eps) =>
    float e0 = array.get(E, 0)
    float L1 = na(e0) ? na : e0 - x0
    float t = na
    if j == 1
        t := math.max(e0 - (ext ? 0.786 : ret2) * L1, x0 + eps)
    else if j == 2
        t := math.max(array.get(E, 1) + (fib3 + (ext ? 1.0 : 0.0)) * L1, e0 + eps)
    else if j == 3
        float l3a = array.get(E, 2) - array.get(E, 1)
        t := math.max(array.get(E, 2) - (ext ? 0.5 : ret4) * l3a, e0 - ovTol * L1 + eps)
    else if j == 4
        float l3b = array.get(E, 2) - array.get(E, 1)
        t := array.get(E, 3) + (fib5 + (ext ? 0.618 : 0.0)) * L1
        // 浪3 延长时「浪5 = 浪1」可能过不了浪3 → 改用「浪5 = 0.618 × (浪1 起点 → 浪3 终点)」
        if t <= array.get(E, 2)
            t := array.get(E, 3) + 0.618 * (array.get(E, 2) - x0)
        if l3b < L1                                   // 浪3 比浪1 短 → 浪5 不能比浪3 长
            t := math.min(t, array.get(E, 3) + l3b)
        if need5                                      // 浪5 越过浪3
            t := math.max(t, array.get(E, 2) + eps)
    else if j == 5
        // ABC 合计回撤 = projRetr × 推动浪；B 回撤 A 的 retB，C = A
        // → 净回撤 = A − retB·A + A = (2 − retB)·A
        float a = projRetr * (array.get(E, 4) - x0) / (2.0 - retB)
        t := math.max(array.get(E, 4) - a * (ext ? 1.618 : 1.0), x0 + eps)
    else if j == 6
        float aB = array.get(E, 4) - array.get(E, 5)
        t := math.min(array.get(E, 5) + (ext ? 0.786 : retB) * aB, array.get(E, 4) - eps)
    else if j == 7
        float aC = array.get(E, 4) - array.get(E, 5)
        t := math.max(array.get(E, 6) - (ext ? 1.618 : 1.0) * aC, x0 + eps)
    else if j == 8
        t := array.get(E, 7) + L1                      // 下一轮浪1 ≈ 上一轮浪1
    else if j == 9
        t := array.get(E, 8) - ret2 * L1
    t

method clearScen(Lv L) =>
    if array.size(L.sL) > 0
        for i = 0 to array.size(L.sL) - 1
            line.delete(array.get(L.sL, i))
        array.clear(L.sL)
    if array.size(L.sB) > 0
        for i = 0 to array.size(L.sB) - 1
            label.delete(array.get(L.sB, i))
        array.clear(L.sB)
    line.delete(L.sRay)

method scenario(Lv L) =>
    L.clearScen()
    L.sK    := -1
    L.sP0   := -1
    L.note  := ""
    L.note2 := ""
    int n = array.size(L.pv)
    if L.dir == 0 or n < 2
        L.note := "枢轴不足（" + str.tostring(n) + " 个）"
    else
        // ── 1. 位置：从最深的解读往浅试，取第一个成立的 —— 能解释最多枢轴的那个。
        //       k = 0（新的浪1 正在走）永远成立，所以一定有结果。
        int kk = 0
        for k = math.min(7, n - 1) to 0
            if scValid(L, k)
                kk := k
                break
        Piv q0 = array.get(L.pv, n - 1 - kk)
        bool bull = not q0.isHigh
        float s = bull ? 1.0 : -1.0
        float xe = s * L.ext
        float x0 = s * q0.price
        float eps = syminfo.mintick

        // ── 2. 高度：走完的段用实际枢轴，正在走和还没走的段用斐波那契目标
        array<float> E = array.new<float>(10, na)
        if kk > 0
            for j = 0 to kk - 1
                Piv pj0 = array.get(L.pv, n - kk + j)
                array.set(E, j, s * pj0.price)
        bool running = bar_index - L.extBi <= 1     // 极值就在最近两根 → 这一段还在走
        bool done = false
        bool extd = false
        for j = kk to 9
            float t = j == 0 ? xe : scTgt(E, x0, j, false, eps)
            if j == kk
                bool up = j % 2 == 0
                bool beyond = up ? xe >= t : xe <= t
                if beyond and running and j > 0
                    // 越过目标、还在走 → 按延长浪取下一档
                    t := scTgt(E, x0, j, true, eps)
                    extd := true
                    beyond := up ? xe >= t : xe <= t
                // 越过目标、已回头 → 暂按这一段在极值处走完
                array.set(E, j, beyond ? xe : t)
                done := beyond
            else
                array.set(E, j, t)

        // ── 3. 角度：同类腿的实测速度。本组走完的腿各一票，本级别近 10 条腿的中位数一票
        array<float> vi = array.new<float>()
        array<float> vc = array.new<float>()
        if kk > 0
            for i = 0 to kk - 1
                Piv a0 = array.get(L.pv, n - 1 - kk + i)
                Piv a1 = array.get(L.pv, n - kk + i)
                float va0 = math.abs(a1.price - a0.price) / math.max(1, a1.bi - a0.bi)
                if scImp(i)
                    array.push(vi, va0)
                else
                    array.push(vc, va0)
        Piv pk = array.get(L.pv, n - 1)
        if L.extBi - pk.bi >= 3                      // 正在走的那段，走了 3 根以上才算数
            float va1 = math.abs(L.ext - pk.price) / (L.extBi - pk.bi)
            if scImp(kk)
                array.push(vi, va1)
            else
                array.push(vc, va1)
        array<float> vAllArr = array.new<float>()
        for i = math.max(0, n - 11) to n - 2
            Piv b0 = array.get(L.pv, i)
            Piv b1 = array.get(L.pv, i + 1)
            array.push(vAllArr, math.abs(b1.price - b0.price) / math.max(1, b1.bi - b0.bi))
        float vAll = array.median(vAllArr)
        array.push(vi, vAll)
        array.push(vc, vAll)
        float vImp = math.max(array.avg(vi), syminfo.mintick)
        float vCor = math.max(array.avg(vc), syminfo.mintick)

        // ── 4. 路径：从「现在」出发。正在走的段若已按走完处理，就从它的极值处接下一段
        float xc = s * close
        array<int>   pt = array.new<int>()
        array<float> px = array.new<float>()
        array<int>   pw = array.new<int>()
        int f = done ? kk + 1 : kk
        if done
            array.push(pt, L.extBi)
            array.push(px, array.get(E, kk))
        else
            array.push(pt, bar_index)
            array.push(px, xc)
        array.push(pw, -1)
        int lastJ = math.min(f + projLegs - 1, 9)
        int tPrev = array.get(pt, 0)
        float xPrev = array.get(px, 0)
        for j = f to lastJ
            float xj = array.get(E, j)
            float vj = scImp(j) ? vImp : vCor
            int tj = tPrev + math.max(1, int(math.round(math.abs(xj - xPrev) / vj)))
            // 按速度这一段本该已经走完、实际却没走完 → 从现价重算剩下的
            if tj <= bar_index
                tj := bar_index + math.max(1, int(math.round(math.abs(xj - xc) / vj)))
            array.push(pt, tj)
            array.push(px, xj)
            array.push(pw, j)
            tPrev := tj
            xPrev := xj

        // TradingView 最多往未来画 500 根。超出就等比例压缩，保持各段角度的相对关系
        int np = array.size(pt)
        int far = array.get(pt, np - 1) - bar_index
        if far > 480
            float sc = 480.0 / far
            int prevT = array.get(pt, 0)
            for ci = 1 to np - 1
                int ti = array.get(pt, ci)
                int tn = ti > bar_index ? bar_index + math.max(1, int(math.round((ti - bar_index) * sc))) : ti
                tn := math.max(tn, prevT + 1)
                array.set(pt, ci, tn)
                prevT := tn

        // ── 5. 画
        color c = L.col
        if done
            array.push(L.sB, label.new(L.extBi, L.ext, L.name + " " + scName(kk) + "?",
                 xloc = xloc.bar_index,
                 style = (kk % 2 == 0) == bull ? label.style_label_down : label.style_label_up,
                 color = color.new(c, 55), textcolor = color.white, size = szLbl))
        for di = 1 to np - 1
            int wj = array.get(pw, di)
            float y0 = s * array.get(px, di - 1)
            float y1 = s * array.get(px, di)
            array.push(L.sL, line.new(array.get(pt, di - 1), y0, array.get(pt, di), y1,
                 xloc = xloc.bar_index, color = c, style = stPrj, width = pWidth))
            float chg = (y1 / close - 1.0) * 100.0
            array.push(L.sB, label.new(array.get(pt, di), y1,
                 L.name + " " + scName(wj) + "  " + str.tostring(y1, format.mintick)
                 + "  " + (chg >= 0 ? "+" : "") + str.tostring(chg, "#.#") + "%",
                 xloc = xloc.bar_index,
                 style = (wj % 2 == 0) == bull ? label.style_label_down : label.style_label_up,
                 color = color.new(c, 25), textcolor = color.white, size = szLbl))
        float yEnd = s * array.get(px, np - 1)
        if projRay
            L.sRay := line.new(bar_index, yEnd, bar_index + 1, yEnd, xloc = xloc.bar_index,
                 extend = extend.right, color = color.new(c, 50), style = line.style_dotted, width = 1)

        // ── 6. 状态表文字
        L.sK  := kk
        L.sP0 := q0.bi
        string pos = scName(kk) + (done ? "? 越过目标·已回头" : extd ? " 延长中" : " 进行中")
        // 浪2 回撤过深的计数很脆弱（合法，但离作废只差一点），直说
        float l1v = array.get(E, 0) - x0
        if (kk >= 2 or (kk == 1 and done)) and l1v > 0
            float r2 = (array.get(E, 0) - array.get(E, 1)) / l1v
            if r2 > 0.886
                pos := pos + " ⚠浪2回撤" + str.tostring(r2 * 100, "#") + "%"
        if L.pvTotal < 12
            pos := "⚠枢轴少 · " + pos
        L.note := pos
        float chgEnd = (yEnd / close - 1.0) * 100.0
        L.note2 := scName(array.get(pw, np - 1)) + " " + str.tostring(yEnd, format.mintick)
             + " (" + (chgEnd >= 0 ? "+" : "") + str.tostring(chgEnd, "#.#") + "%)"

// ───────────────────────────────────────────────────────── 6. 每根维护

// 输入可能被改；每根同步回对象，免得改了参数不生效
LA.mult := useA
LA.col  := cA
LA.wid  := wA
LA.on   := onA
LB.mult := useB
LB.col  := cB
LB.wid  := wB
LB.on   := onB
LC.mult := useC
LC.col  := cC
LC.wid  := wC
LC.on   := onC

bool hitA = false
bool hitB = false
bool hitC = false

if LA.on and atrOk and LA.zigzag(atrV * LA.mult)
    hitA := LA.detect()
if LB.on and atrOk and LB.zigzag(atrV * LB.mult)
    hitB := LB.detect()
if LC.on and atrOk and LC.zigzag(atrV * LC.mult)
    hitC := LC.detect()

LA.sweep()
LB.sweep()
LC.sweep()

// 场景推演只在最后一根上画（它只在「现在」有意义）。
// 两个级别选中了同一个起点、同一个位置时，推出来的路径完全一样 —— 只画更细的那个。
if showProj and barstate.islast
    if LA.on
        LA.scenario()
    if LB.on
        LB.scenario()
        if LA.on and LB.sK >= 0 and LB.sK == LA.sK and LB.sP0 == LA.sP0
            LB.clearScen()
            LB.note := "同「" + LA.name + "」的场景，不重复画"
            LB.note2 := ""
    if LC.on
        LC.scenario()
        if LA.on and LC.sK >= 0 and LC.sK == LA.sK and LC.sP0 == LA.sP0
            LC.clearScen()
            LC.note := "同「" + LA.name + "」的场景，不重复画"
            LC.note2 := ""
        else if LB.on and LC.sK >= 0 and LC.sK == LB.sK and LC.sP0 == LB.sP0
            LC.clearScen()
            LC.note := "同「" + LB.name + "」的场景，不重复画"
            LC.note2 := ""

float tgtA = LA.on ? LA.activeTgt() : na
float tgtB = LB.on ? LB.activeTgt() : na
float tgtC = LC.on ? LC.activeTgt() : na
bool  wvBull = (hitA and LA.lastDir > 0) or (hitB and LB.lastDir > 0) or (hitC and LC.lastDir > 0)
bool  wvBear = (hitA and LA.lastDir < 0) or (hitB and LB.lastDir < 0) or (hitC and LC.lastDir < 0)

method tblRow(Lv L, table tb, int r, float m) =>
    table.cell(tb, 0, r, L.name, text_color = L.col, text_size = szT)
    table.cell(tb, 1, r, L.on ? "ATR×" + str.tostring(m) : "关", text_color = L.col, text_size = szT)
    table.cell(tb, 2, r, L.on ? str.tostring(L.pvTotal) + " · " + str.tostring(L.hits) : "",
         text_color = L.col, text_size = szT)
    table.cell(tb, 3, r, L.on ? (showProj ? L.note : "推演已关闭") : "",
         text_color = L.col, text_size = szT, text_halign = text.align_left)
    table.cell(tb, 4, r, L.on and showProj ? L.note2 : "",
         text_color = L.col, text_size = szT, text_halign = text.align_left)

if showTbl and barstate.islast
    var table tb = table.new(position.bottom_right, 5, 5,
         bgcolor = color.new(color.black, 15), border_width = 1,
         border_color = color.new(color.gray, 60),
         frame_width = 1, frame_color = color.new(color.gray, 40))
    table.cell(tb, 0, 0, "级别",      text_color = color.silver, text_size = szT)
    table.cell(tb, 1, 0, tfAuto ? "阈值(自动)" : "阈值(手动)", text_color = color.silver, text_size = szT)
    table.cell(tb, 2, 0, "枢轴·命中", text_color = color.silver, text_size = szT)
    table.cell(tb, 3, 0, "当前位置",  text_color = color.silver, text_size = szT)
    table.cell(tb, 4, 0, "推演终点",  text_color = color.silver, text_size = szT)
    LA.tblRow(tb, 1, useA)
    LB.tblRow(tb, 2, useB)
    LC.tblRow(tb, 3, useC)
    table.cell(tb, 0, 4, "⚠", text_color = color.orange, text_size = szT)
    table.cell(tb, 1, 4, str.tostring(bar_index + 1) + " 根", text_color = color.orange, text_size = szT)
    table.cell(tb, 2, 4, "每根重算", text_color = color.orange, text_size = szT)
    table.cell(tb, 3, 4, "? = 越过目标已回头，暂按走完", text_color = color.orange, text_size = szT,
         text_halign = text.align_left)
    table.cell(tb, 4, 4, "推演是推论，不是信号", text_color = color.orange, text_size = szT,
         text_halign = text.align_left)

// ───────────────────────────────────────────────────────── 7. 警报

alertcondition(hitA or hitB or hitC, "推动浪成立（任意级别）", "1-2-3-4-5 推动浪校验通过")
alertcondition(hitA, "推动浪成立 · 细", "级别「细」出现 1-2-3-4-5")
alertcondition(hitB, "推动浪成立 · 中", "级别「中」出现 1-2-3-4-5")
alertcondition(hitC, "推动浪成立 · 粗", "级别「粗」出现 1-2-3-4-5")

// ───────────────────────────────────────────────────────── 8. 样式页输出
//
// TradingView 的「样式」标签页只收 plot 家族的输出。场景推演是绘图对象，进不了
// 样式页；下面这些能进：已确认推动浪的调整目标（到达目标或越过浪5 终点就断开），
// 和推动浪成立的事件标记。

plot(tgtA, "细 · 已确认推动浪的调整目标", color = #42a5f5, linewidth = 1,
     style = plot.style_linebr, display = display.pane)
plot(tgtB, "中 · 已确认推动浪的调整目标", color = #ab47bc, linewidth = 1,
     style = plot.style_linebr, display = display.pane)
plot(tgtC, "粗 · 已确认推动浪的调整目标", color = #ffa726, linewidth = 1,
     style = plot.style_linebr, display = display.pane)

plotshape(wvBull, "事件 · 看涨推动浪成立", shape.triangleup, location.belowbar,
     color = #26a69a, size = size.small)
plotshape(wvBear, "事件 · 看跌推动浪成立", shape.triangledown, location.abovebar,
     color = #ef5350, size = size.small)
