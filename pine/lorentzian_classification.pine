//@version=6
// =============================================================================
// Lorentzian Classification — 复刻 + 诚实仪表
// =============================================================================
// 按 Lorentzian Classification Premium 的说明文档复刻其核心算法，并把校准面板
// 换成一组**能判断真假**的指标。
//
// 算法本身（和开源版一致的部分）：
//   把若干技术指标归一化成特征坐标，用 Lorentzian 距离 d = Σ log(1+|Δfᵢ|)
//   在历史上找 k 个最相似的 bar，每个邻居按「它之后 N 根 bar 往哪走」投票，
//   票数求和得到 −k..+k 的预测分。再叠加波动率/趋势/ADX/均线/核回归过滤。
//
// 为什么面板要重做：
//   Premium 宣传图里是 Win Rate 92.9%、Profit Factor 49.4，而同一张表上
//   Sharpe 0.29、Sortino 0.589。这三个数不相容，而该信的是后两个 ——
//   **高胜率配低 Sharpe 的唯一解释是赢得少、输得多**。胜率首先是止盈止损
//   结构的性质，其次才是策略的性质：任何 1:3 的括号在随机游走上都约 25% 胜率，
//   任何 3:1 的括号都约 75%，和信号好坏无关。
//
//   所以这里报的是：期望值（以 ATR 为单位）、盈亏比、**以及同期"闭眼做多"
//   的基准胜率**。信号胜率 56% 听着不错，但如果同期 55% 的 N 根 bar 前向
//   移动本来就是涨的，那 56% 什么都不是。面板会直接把这个差值算给你。
//
// 已知的坑，标在代码里：
//   1  标签对齐（第 3 节）。这决定了你在预测未来还是在描述过去。
//   2  近邻扫描不是教科书 k-NN（第 4 节），它是个有偏采样器。
//   3  面板统计**没有扣手续费和资金费率**，原版也没有。币安 U 本位永续
//      普通用户吃单 5bp/边，一来一回 10bp；持仓过结算点还要付资金费率。
//      短周期高频信号很容易在毛收益为正的情况下净亏。
// =============================================================================

indicator("Lorentzian Classification 复刻版", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_bars_back = 5000)

// ───────────────────────────────────────────────────────── 1. 输入

grpCore = "核心"
srcIn        = input.source(close, "价格源",                    group = grpCore)
neighbors    = input.int(8,  "邻居数 k",  minval = 1, maxval = 32, group = grpCore,
     tooltip = "k-NN 的 k。预测分的范围就是 −k..+k。文档里的网格搜索说最优 k 随行情状态在 8~50 之间跳 —— 这句话本身就是在说它不稳定。")
maxBarsBack  = input.int(2000, "回溯上限", minval = 100, maxval = 5000, step = 100, group = grpCore,
     tooltip = "在多少根历史 bar 里找邻居。越大越慢，而且越可能把完全不同的行情状态当成近邻。")
holdBars     = input.int(4,  "标签窗口 N", minval = 1, maxval = 50, group = grpCore,
     tooltip = "邻居投票的内容：它之后 N 根 bar 的方向。也是统计面板里的默认持有期。")
reduceWarp   = input.bool(false, "削弱价格-时间扭曲", group = grpCore,
     tooltip = "打开后距离用 |Δf| 而不是 log(1+|Δf|)，也就是退回 Manhattan 距离。Lorentzian 的全部特点就在那个 log 上：它压缩大偏差，所以某一维差得离谱的 bar 仍可能被算作近邻。")

grpLabel = "标签对齐（重要）"
forwardLabel = input.bool(true, "用前向标签（推荐）", group = grpLabel,
     tooltip = "打开：bar i 的标签 = 从 i 到 i+N 的方向，也就是真正的「之后会怎样」，代价是最近 N 根 bar 不能进训练集。\n关闭：bar i 的标签 = 从 i−N 到 i 的方向，即**已经发生过**的那段。\n两者只差一个偏移量，但意义完全不同 —— 一个是预测，一个是描述。流传的开源版本里这一行值得你自己核对一遍。")

grpFeat = "特征"
featureCount = input.int(5, "启用特征数", minval = 2, maxval = 10, group = grpFeat,
     tooltip = "前 5 个是内置的，6~10 是自定义源。文档建议从 3~5 个开始。维度越高，近邻越稀疏 —— 这是维数灾难，不是「分析能力翻三倍」。")
f1Type = input.string("RSI", "特征 1", options = ["RSI","WT","CCI","ADX"], group = grpFeat)
f1A    = input.int(14, "  参数 A", inline = "f1", group = grpFeat)
f1B    = input.int(2,  "  参数 B", inline = "f1", group = grpFeat)
f2Type = input.string("WT",  "特征 2", options = ["RSI","WT","CCI","ADX"], group = grpFeat)
f2A    = input.int(10, "  参数 A", inline = "f2", group = grpFeat)
f2B    = input.int(11, "  参数 B", inline = "f2", group = grpFeat)
f3Type = input.string("CCI", "特征 3", options = ["RSI","WT","CCI","ADX"], group = grpFeat)
f3A    = input.int(20, "  参数 A", inline = "f3", group = grpFeat)
f3B    = input.int(1,  "  参数 B", inline = "f3", group = grpFeat)
f4Type = input.string("ADX", "特征 4", options = ["RSI","WT","CCI","ADX"], group = grpFeat)
f4A    = input.int(20, "  参数 A", inline = "f4", group = grpFeat)
f4B    = input.int(2,  "  参数 B", inline = "f4", group = grpFeat)
f5Type = input.string("RSI", "特征 5", options = ["RSI","WT","CCI","ADX"], group = grpFeat)
f5A    = input.int(9,  "  参数 A", inline = "f5", group = grpFeat)
f5B    = input.int(1,  "  参数 B", inline = "f5", group = grpFeat)

grpCustom = "自定义特征源 6~10"
c6  = input.source(close, "源 6",  group = grpCustom)
c7  = input.source(close, "源 7",  group = grpCustom)
c8  = input.source(close, "源 8",  group = grpCustom)
c9  = input.source(close, "源 9",  group = grpCustom)
c10 = input.source(close, "源 10", group = grpCustom)
normCustom = input.bool(true, "自定义源自动归一化", group = grpCustom,
     tooltip = "必须开，除非你的源本来就在 0~1。Lorentzian 距离对各维等权相加，量纲不统一等于让某一维独占话语权。")

grpFilter = "过滤器"
useVolFilter    = input.bool(true,  "波动率过滤", group = grpFilter)
useRegimeFilter = input.bool(true,  "趋势状态过滤", group = grpFilter)
regimeThreshold = input.float(-0.1, "  状态阈值", minval = -10, maxval = 10, step = 0.1, group = grpFilter)
useAdxFilter    = input.bool(false, "ADX 过滤", group = grpFilter)
adxLength       = input.int(14, "  ADX 长度", group = grpFilter)
adxThreshold    = input.int(20, "  ADX 阈值", group = grpFilter)
useEmaFilter    = input.bool(false, "EMA 过滤", group = grpFilter)
emaPeriod       = input.int(200, "  EMA 周期", group = grpFilter)
useSmaFilter    = input.bool(false, "SMA 过滤", group = grpFilter)
smaPeriod       = input.int(200, "  SMA 周期", group = grpFilter)
useHtfFilter    = input.bool(false, "日线核过滤（低周期用）", group = grpFilter,
     tooltip = "只接受与日线核回归方向一致的信号。日线及以上周期自动失效。")

grpKernel = "核回归"
useKernel      = input.bool(true, "启用核回归", group = grpKernel)
kLookback      = input.int(8,    "  回看窗口", minval = 3, group = grpKernel)
kRelWeight     = input.float(8., "  相对权重", minval = 0.25, step = 0.25, group = grpKernel)
kRegLevel      = input.int(25,   "  回归起点", minval = 2, group = grpKernel)
kLag           = input.int(2,    "  滞后", minval = 1, group = grpKernel)
useKernelFilter= input.bool(true, "  用核方向过滤信号", group = grpKernel)

grpEnv = "包络（均值回归）"
useEnvelope = input.bool(true, "启用包络", group = grpEnv)
envAtrLen   = input.int(14,   "  ATR 长度", group = grpEnv)
envNear     = input.float(1.5, "  近带 ATR 倍数", step = 0.1, group = grpEnv)
envFar      = input.float(3.0, "  远带 ATR 倍数", step = 0.1, group = grpEnv)

grpSig = "信号"
showMain     = input.bool(true, "主信号箭头", group = grpSig)
showPullback = input.bool(true, "首次回调三角", group = grpSig)
showRevert   = input.bool(true, "均值回归标记", group = grpSig)
showBarScore = input.bool(false, "每根 bar 的预测分", group = grpSig)
colorBars    = input.bool(false, "按预测分给 K 线上色", group = grpSig)

grpStats = "校准面板"
showStats  = input.bool(true, "显示面板", group = grpStats)
statsHold  = input.int(0, "统计持有期（0 = 用标签窗口 N）", minval = 0, group = grpStats,
     tooltip = "面板按「进场后持有这么多根 bar」结算。和真实交易的出场规则不一样，所以它是校准工具，不是回测。")

// ───────────────────────────────────────────────────────── 2. 归一化与特征

rescale(src, oldMin, oldMax, newMin, newMax) =>
    newMin + (newMax - newMin) * (src - oldMin) / math.max(oldMax - oldMin, 1e-10)

// 走式（running）最小最大值归一化。它只用已经发生过的极值，所以不偷看未来 ——
// 但代价是**同一根 bar 的特征值会随着后来出现新极值而改变含义**，这在任何
// 基于历史相似度的方法里都是一层看不见的漂移。
normalize(src, minTarget, maxTarget) =>
    var float hMin =  1e10
    var float hMax = -1e10
    hMin := math.min(nz(src, hMin), hMin)
    hMax := math.max(nz(src, hMax), hMax)
    minTarget + (maxTarget - minTarget) * (src - hMin) / math.max(hMax - hMin, 1e-10)

n_rsi(src, n1, n2) => rescale(ta.ema(ta.rsi(src, n1), n2), 0, 100, 0, 1)

n_cci(src, n1, n2) => normalize(ta.ema(ta.cci(src, n1), n2), 0, 1)

n_wt(src, n1, n2) =>
    e1 = ta.ema(src, n1)
    e2 = ta.ema(math.abs(src - e1), n1)
    ci = (src - e1) / (0.015 * math.max(e2, 1e-10))
    w1 = ta.ema(ci, n2)
    w2 = ta.sma(w1, 4)
    normalize(w1 - w2, 0, 1)

n_adx(n1) =>
    [_p, _m, adxv] = ta.dmi(n1, n1)
    rescale(adxv, 0, 100, 0, 1)

pickFeature(t, a, b) =>
    t == "RSI" ? n_rsi(srcIn, a, b) :
     t == "WT"  ? n_wt(hlc3, a, b)   :
     t == "CCI" ? n_cci(srcIn, a, b) :
     n_adx(a)

f1 = pickFeature(f1Type, f1A, f1B)
f2 = pickFeature(f2Type, f2A, f2B)
f3 = pickFeature(f3Type, f3A, f3B)
f4 = pickFeature(f4Type, f4A, f4B)
f5 = pickFeature(f5Type, f5A, f5B)
f6  = normCustom ? normalize(c6,  0, 1) : c6
f7  = normCustom ? normalize(c7,  0, 1) : c7
f8  = normCustom ? normalize(c8,  0, 1) : c8
f9  = normCustom ? normalize(c9,  0, 1) : c9
f10 = normCustom ? normalize(c10, 0, 1) : c10

var a1 = array.new<float>(0)
var a2 = array.new<float>(0)
var a3 = array.new<float>(0)
var a4 = array.new<float>(0)
var a5 = array.new<float>(0)
var a6 = array.new<float>(0)
var a7 = array.new<float>(0)
var a8 = array.new<float>(0)
var a9 = array.new<float>(0)
var a10 = array.new<float>(0)
array.push(a1, f1)
array.push(a2, f2)
array.push(a3, f3)
array.push(a4, f4)
array.push(a5, f5)
array.push(a6, f6)
array.push(a7, f7)
array.push(a8, f8)
array.push(a9, f9)
array.push(a10, f10)

// ───────────────────────────────────────────────────────── 3. 标签
//
// 这是整个指标里**唯一一处对错会颠覆结论**的地方。
//
// 前向标签：bar i 的标签 = sign(close[i+N] − close[i])，即 i 之后发生了什么。
//   这才是「预测」。代价是最近 N 根 bar 的标签还不存在，必须排除在训练集外 ——
//   下面的近邻扫描因此从 N 根之前开始。
//
// 后向标签：bar i 的标签 = sign(close[i] − close[i−N])，即 i 之前发生了什么。
//   模型学到的是「特征长这样时，刚才那段是涨的」。拿它做交易，等于用当前特征
//   去复述已经过去的行情。
//
// 两种只差一个偏移。留成开关是为了让你能亲眼比一遍，而不是听我说。

// 两种模式用的是**同一个数**，区别只在于把它对齐到哪一根 bar 上：
// 在 bar t 算出的 sign(close[t] − close[t−N])，既是 t 的「过去 N 根」，
// 也是 t−N 的「未来 N 根」。前向模式读 yArr[i+N]，后向模式读 yArr[i]。
labelMove = math.sign(srcIn[0] - srcIn[holdBars])

var yArr = array.new<float>(0)
array.push(yArr, labelMove)

// 前向模式下，bar i 的标签存在 yArr 的 i+N 位置（因为那一刻才算得出来）。
labelAt(i) =>
    idx = forwardLabel ? i + holdBars : i
    idx < array.size(yArr) ? array.get(yArr, idx) : 0.0

// ───────────────────────────────────────────────────────── 4. Lorentzian k-NN
//
// 距离：d = Σ log(1 + |Δfᵢ|)。那个 log 是 Lorentzian 的全部特点 —— 它压缩大偏差，
// 所以某一维差得离谱、其余维接近的 bar 仍可能被算作近邻。文档里那张图（十字形
// 的邻域）画的就是这件事。好处是在剧烈行情里不会因为单维爆表就丢掉整个样本；
// 坏处是**"相似"的定义被稀释了**，高维下尤其明显。
//
// 下面的扫描不是教科书 k-NN，而是原版的近似写法，照搬过来并注明它实际做了什么：
//   - 只看 i % 4 == 0 的 bar（时间降采样，避免邻居全挤在同一段行情里）
//   - 只在 d >= lastDistance 时才收下候选，然后把门槛提到已收集距离的 75% 分位
// 结果是它**不保证**取到真正最近的 k 个，而是一个偏向「距离较大但分散」的采样器。
// 这不一定更差 —— 但它不是 k-NN，写成 k-NN 会让人高估它的理论保证。

lorentz(i) =>
    d = 0.0
    d += reduceWarp ? math.abs(f1 - array.get(a1, i)) : math.log(1 + math.abs(f1 - array.get(a1, i)))
    if featureCount >= 2
        d += reduceWarp ? math.abs(f2 - array.get(a2, i)) : math.log(1 + math.abs(f2 - array.get(a2, i)))
    if featureCount >= 3
        d += reduceWarp ? math.abs(f3 - array.get(a3, i)) : math.log(1 + math.abs(f3 - array.get(a3, i)))
    if featureCount >= 4
        d += reduceWarp ? math.abs(f4 - array.get(a4, i)) : math.log(1 + math.abs(f4 - array.get(a4, i)))
    if featureCount >= 5
        d += reduceWarp ? math.abs(f5 - array.get(a5, i)) : math.log(1 + math.abs(f5 - array.get(a5, i)))
    if featureCount >= 6
        d += reduceWarp ? math.abs(f6 - array.get(a6, i)) : math.log(1 + math.abs(f6 - array.get(a6, i)))
    if featureCount >= 7
        d += reduceWarp ? math.abs(f7 - array.get(a7, i)) : math.log(1 + math.abs(f7 - array.get(a7, i)))
    if featureCount >= 8
        d += reduceWarp ? math.abs(f8 - array.get(a8, i)) : math.log(1 + math.abs(f8 - array.get(a8, i)))
    if featureCount >= 9
        d += reduceWarp ? math.abs(f9 - array.get(a9, i)) : math.log(1 + math.abs(f9 - array.get(a9, i)))
    if featureCount >= 10
        d += reduceWarp ? math.abs(f10 - array.get(a10, i)) : math.log(1 + math.abs(f10 - array.get(a10, i)))
    d

var distances = array.new<float>(0)
var predVotes = array.new<float>(0)

prediction = 0.0
if bar_index > holdBars + 10
    array.clear(distances)
    array.clear(predVotes)
    lastDistance = -1.0
    // 前向标签时，最后 N 根 bar 的标签尚未存在，扫描必须停在那之前
    scanEnd = math.max(0, array.size(a1) - 1 - (forwardLabel ? holdBars : 0))
    scanStart = math.max(0, scanEnd - maxBarsBack)
    for i = scanStart to scanEnd
        if i % 4 == 0
            d = lorentz(i)
            if d >= lastDistance
                lastDistance := d
                array.push(distances, d)
                array.push(predVotes, labelAt(i))
                if array.size(predVotes) > neighbors
                    lastDistance := array.get(distances, math.round(neighbors * 3 / 4))
                    array.shift(distances)
                    array.shift(predVotes)
    prediction := array.sum(predVotes)

// ───────────────────────────────────────────────────────── 5. 过滤器

// KLMF 斜率。自适应卡尔曼式平滑，再看斜率相对其长期均值是否衰减。
// 状态变量放在全局：Pine 里对函数内的局部变量取历史值（v1[1]）是不可靠的。
var float klmfV1 = 0.0
var float klmfV2 = 0.0
var float klmf   = 0.0
klmfV1 := 0.2 * (close - nz(close[1], close)) + 0.8 * nz(klmfV1[1], 0.0)
klmfV2 := 0.1 * (high - low) + 0.8 * nz(klmfV2[1], 0.0)
klmfOmega = math.abs(klmfV1 / math.max(klmfV2, 1e-10))
klmfAlpha = (-math.pow(klmfOmega, 2) + math.sqrt(math.pow(klmfOmega, 4) + 16 * math.pow(klmfOmega, 2))) / 8
klmf := klmfAlpha * close + (1 - klmfAlpha) * nz(klmf[1], close)
klmfSlope    = math.abs(klmf - nz(klmf[1], klmf))
klmfAvgSlope = ta.ema(klmfSlope, 200)
klmfDecline  = (klmfSlope - klmfAvgSlope) / math.max(klmfAvgSlope, 1e-10)
regimeOk = not useRegimeFilter or klmfDecline >= regimeThreshold

[_adxP, _adxM, adxVal] = ta.dmi(adxLength, adxLength)
adxOk = not useAdxFilter or adxVal > adxThreshold

volOk = not useVolFilter or ta.atr(1) > ta.atr(10)

emaV = ta.ema(close, emaPeriod)
smaV = ta.sma(close, smaPeriod)
filterEmaUp  = not useEmaFilter or close > emaV
filterEmaDn  = not useEmaFilter or close < emaV
filterSmaUp  = not useSmaFilter or close > smaV
filterSmaDn  = not useSmaFilter or close < smaV

// ───────────────────────────────────────────────────────── 6. 核回归与包络

// Nadaraya-Watson，有理二次核。它是一条**自适应均线**，不是预测器 ——
// 名字里的 regression 容易让人以为它在外推，其实它只是加权平均了过去。
kernelRQ(src, lookback, relWeight, startAt) =>
    num = 0.0
    den = 0.0
    for i = 0 to math.min(startAt + 20, 200)
        w = math.pow(1 + math.pow(i, 2) / (math.pow(lookback, 2) * 2 * relWeight), -relWeight)
        num += nz(src[i], src) * w
        den += w
    num / math.max(den, 1e-10)

kernelGauss(src, lookback, startAt) =>
    num = 0.0
    den = 0.0
    for i = 0 to math.min(startAt + 20, 200)
        w = math.exp(-math.pow(i, 2) / (2 * math.pow(lookback, 2)))
        num += nz(src[i], src) * w
        den += w
    num / math.max(den, 1e-10)

kMain = useKernel ? kernelRQ(srcIn, kLookback, kRelWeight, kRegLevel) : na
kLagL = useKernel ? kernelGauss(srcIn, math.max(kLookback - kLag, 2), kRegLevel) : na
kBull = useKernel and not na(kMain) ? kMain > nz(kMain[1], kMain) : true
kBear = useKernel and not na(kMain) ? kMain < nz(kMain[1], kMain) : true

atrEnv  = ta.atr(envAtrLen)
envUpN  = kMain + atrEnv * envNear
envDnN  = kMain - atrEnv * envNear
envUpF  = kMain + atrEnv * envFar
envDnF  = kMain - atrEnv * envFar

// 日线核方向。
// 注意 kernelDaily 必须是一个**全局变量**再取 [1]：Pine 不允许对函数调用的
// 结果直接用历史运算符（kernelRQ(...)[1] 会报错）。取 [1] 是为了只用已经
// 收盘的日线值 —— 否则当天还在跳动的日线核会让信号在盘中反复改写。
kernelDaily = kernelRQ(close, kLookback, kRelWeight, kRegLevel)
htfKernel = request.security(syminfo.tickerid, "D", kernelDaily[1],
     lookahead = barmerge.lookahead_off)
isDailyOrHigher = timeframe.in_seconds(timeframe.period) >= 86400
htfUp = not useHtfFilter or isDailyOrHigher or (not na(htfKernel) and htfKernel > nz(htfKernel[1], htfKernel))
htfDn = not useHtfFilter or isDailyOrHigher or (not na(htfKernel) and htfKernel < nz(htfKernel[1], htfKernel))

// ───────────────────────────────────────────────────────── 7. 信号

filtersPass = volOk and regimeOk and adxOk
kernelOkUp  = not useKernelFilter or kBull
kernelOkDn  = not useKernelFilter or kBear

longOk  = prediction > 0 and filtersPass and filterEmaUp and filterSmaUp and kernelOkUp and htfUp
shortOk = prediction < 0 and filtersPass and filterEmaDn and filterSmaDn and kernelOkDn and htfDn

var int signalDir = 0
signalDir := longOk ? 1 : shortOk ? -1 : nz(signalDir[1], 0)
isNewLong  = signalDir ==  1 and nz(signalDir[1], 0) !=  1
isNewShort = signalDir == -1 and nz(signalDir[1], 0) != -1

// 首次回调：主信号之后，价格第一次回到核回归线附近又收回去，且核方向未变。
// 「第一次」是关键 —— 同一段趋势里只发一次，否则它会退化成每根 bar 都在喊。
var int  pbDir   = 0
var bool pbFired = false
if isNewLong
    pbDir := 1
    pbFired := false
if isNewShort
    pbDir := -1
    pbFired := false

pullbackLong  = showPullback and not pbFired and pbDir == 1 and useKernel and
     low <= kMain and close > kMain and kBull
pullbackShort = showPullback and not pbFired and pbDir == -1 and useKernel and
     high >= kMain and close < kMain and kBear
if pullbackLong or pullbackShort
    pbFired := true

// 均值回归：穿近带 = 普通，穿远带 = 强
revUpReg   = useEnvelope and showRevert and ta.crossunder(close, envDnN)
revDnReg   = useEnvelope and showRevert and ta.crossover(close, envUpN)
revUpStr   = useEnvelope and showRevert and ta.crossunder(close, envDnF)
revDnStr   = useEnvelope and showRevert and ta.crossover(close, envUpF)

// −6..+6 数值流，给外部回测框架用。正数看多、负数看空、绝对值是信号类型。
//   ±1 主信号   ±2 首次回调   ±3 普通均值回归   ±4 强均值回归
//   ±5 核方向翻转           ±6 主信号出场
kFlipUp = useKernel and kBull and not nz(kBull[1], false)
kFlipDn = useKernel and kBear and not nz(kBear[1], false)
stream = isNewLong ? 1 : isNewShort ? -1 :
     pullbackLong ? 2 : pullbackShort ? -2 :
     revUpReg ? 3 : revDnReg ? -3 :
     revUpStr ? 4 : revDnStr ? -4 :
     kFlipUp ? 5 : kFlipDn ? -5 : 0

// ───────────────────────────────────────────────────────── 8. 绘图

plot(useKernel  ? kMain : na, "核回归",   color = kBull ? color.new(color.teal, 0) : color.new(color.red, 0), linewidth = 2)
plot(useKernel  ? kLagL : na, "核（滞后）", color = color.new(color.gray, 40))
uN = plot(useEnvelope ? envUpN : na, "近带上", color = color.new(color.gray, 70))
dN = plot(useEnvelope ? envDnN : na, "近带下", color = color.new(color.gray, 70))
uF = plot(useEnvelope ? envUpF : na, "远带上", color = color.new(color.gray, 85))
dF = plot(useEnvelope ? envDnF : na, "远带下", color = color.new(color.gray, 85))
fill(uN, uF, color = color.new(color.gray, 92))
fill(dN, dF, color = color.new(color.gray, 92))

plotshape(showMain and isNewLong,  "做多", shape.labelup,   location.belowbar,
     color.new(color.teal, 0), text = "▲", textcolor = color.white, size = size.small)
plotshape(showMain and isNewShort, "做空", shape.labeldown, location.abovebar,
     color.new(color.red, 0),  text = "▼", textcolor = color.white, size = size.small)
plotshape(pullbackLong,  "回调多", shape.triangleup,   location.belowbar, color.new(color.lime, 0),   size = size.tiny)
plotshape(pullbackShort, "回调空", shape.triangledown, location.abovebar, color.new(color.orange, 0), size = size.tiny)
plotshape(revUpReg, "回归↑", shape.circle, location.belowbar, color.new(color.blue, 30),   size = size.tiny)
plotshape(revDnReg, "回归↓", shape.circle, location.abovebar, color.new(color.purple, 30), size = size.tiny)
plotshape(revUpStr, "强回归↑", shape.diamond, location.belowbar, color.new(color.blue, 0),   size = size.tiny)
plotshape(revDnStr, "强回归↓", shape.diamond, location.abovebar, color.new(color.purple, 0), size = size.tiny)

scoreCol = prediction > 0 ? color.new(color.teal, math.max(0, 80 - int(math.abs(prediction) / neighbors * 80)))
     : prediction < 0 ? color.new(color.red, math.max(0, 80 - int(math.abs(prediction) / neighbors * 80)))
     : color.new(color.gray, 80)
barcolor(colorBars ? scoreCol : na)

// 预测分要显示成数字，只能用 label —— Pine 没有「在 bar 上打印数值」的绘图函数。
// label 总数有上限（500），所以只标最近这些根，否则老的会被静默丢弃，
// 看起来像是历史上根本没有信号。
if showBarScore and bar_index > last_bar_index - 300
    label.new(bar_index, high + ta.atr(14) * 0.5, str.tostring(prediction, "#"),
         style = label.style_none, textcolor = scoreCol, size = size.tiny)

plot(stream, "回测数值流", display = display.data_window)
plot(prediction, "预测分", display = display.data_window)

// ───────────────────────────────────────────────────────── 9. 校准面板
//
// 报的不是宣传数字，是能判断真假的那几个：
//   期望值(R)   每笔平均赚多少个 ATR。**这是唯一直接决定盈亏的数。**
//   盈亏比      平均盈利 / 平均亏损。它和胜率共同决定期望值 ——
//               单看胜率没有任何意义。
//   基准胜率    同期「闭眼做多、持有同样根数」的胜率。
//   超额        信号胜率 − 基准胜率。**这一列接近 0，说明信号没提供信息**，
//               哪怕胜率写着 90%。

hb = statsHold > 0 ? statsHold : holdBars

var int   nTrades = 0
var int   nWins   = 0
var float sumWinR = 0.0
var float sumLosR = 0.0
var int   nBase   = 0
var int   nBaseUp = 0
// 多空要分开统计，否则没法和各自的基准比：做多的基准是「同期上涨的比例」，
// 做空的基准是「同期下跌的比例」，两者相加是 1，混在一起算会互相抵消掉，
// 最后得到的「超额」恒等于 胜率 − 50%，那是个假指标。
var int   nLong   = 0
var int   nLongW  = 0
var int   nShort  = 0
var int   nShortW = 0

var int   openDir  = 0
var int   openBar  = 0
var float openPx   = 0.0
var float openAtr  = 0.0

atr14 = ta.atr(14)

// 基准：所有 bar 的 hb 根前向移动里，涨的占多少
if bar_index > hb
    nBase += 1
    nBaseUp += close > close[hb] ? 1 : 0

if openDir != 0 and bar_index - openBar >= hb
    r = (close - openPx) / math.max(openAtr, 1e-10) * openDir
    nTrades += 1
    won = r > 0
    if won
        nWins += 1
        sumWinR += r
    else
        sumLosR += math.abs(r)
    if openDir == 1
        nLong += 1
        nLongW += won ? 1 : 0
    else
        nShort += 1
        nShortW += won ? 1 : 0
    openDir := 0

if openDir == 0 and (isNewLong or isNewShort)
    openDir := isNewLong ? 1 : -1
    openBar := bar_index
    openPx  := close
    openAtr := atr14

winRate   = nTrades > 0 ? nWins / nTrades : na
avgWin    = nWins > 0 ? sumWinR / nWins : na
avgLoss   = (nTrades - nWins) > 0 ? sumLosR / (nTrades - nWins) : na
payoff    = not na(avgWin) and not na(avgLoss) and avgLoss > 0 ? avgWin / avgLoss : na
expectR   = nTrades > 0 ? (sumWinR - sumLosR) / nTrades : na
profitF   = sumLosR > 0 ? sumWinR / sumLosR : na
baseUp    = nBase > 0 ? nBaseUp / nBase : na
baseDn    = na(baseUp) ? na : 1 - baseUp
// 信号加权的基准：每笔交易按自己的方向对应的基准，再按笔数加权
baseMix   = nTrades > 0 and not na(baseUp) ? (nLong * baseUp + nShort * baseDn) / nTrades : na
excess    = not na(winRate) and not na(baseMix) ? winRate - baseMix : na

if showStats and barstate.islast
    var table t = table.new(position.top_right, 2, 11, border_width = 1)
    table.cell(t, 0, 0, "校准面板", bgcolor = color.new(color.gray, 20), text_color = color.white)
    table.cell(t, 1, 0, str.tostring(nTrades) + " 笔（多 " + str.tostring(nLong) + " / 空 " + str.tostring(nShort) + "）",
         bgcolor = color.new(color.gray, 20), text_color = color.white)
    table.cell(t, 0, 1, "胜率")
    table.cell(t, 1, 1, na(winRate) ? "—" : str.tostring(winRate * 100, "#.#") + "%")
    table.cell(t, 0, 2, "基准胜率")
    table.cell(t, 1, 2, na(baseMix) ? "—" : str.tostring(baseMix * 100, "#.#") + "%")
    table.cell(t, 0, 3, "超额")
    table.cell(t, 1, 3, na(excess) ? "—" : str.tostring(excess * 100, "+#.#") + "%",
         text_color = na(excess) ? color.gray : excess > 0 ? color.teal : color.red)
    table.cell(t, 0, 4, "盈亏比")
    table.cell(t, 1, 4, na(payoff) ? "—" : str.tostring(payoff, "#.##"))
    table.cell(t, 0, 5, "期望值(R)")
    table.cell(t, 1, 5, na(expectR) ? "—" : str.tostring(expectR, "+#.###"),
         text_color = na(expectR) ? color.gray : expectR > 0 ? color.teal : color.red)
    table.cell(t, 0, 6, "盈利因子")
    table.cell(t, 1, 6, na(profitF) ? "—" : str.tostring(profitF, "#.##"))
    table.cell(t, 0, 7, "持有期")
    table.cell(t, 1, 7, str.tostring(hb) + " 根")
    warn = nTrades < 30 ? "笔数太少，无统计意义" :
         not na(excess) and math.abs(excess) < 0.03 ? "超额≈0：信号没提供信息" :
         not na(winRate) and not na(expectR) and winRate > 0.7 and expectR < 0.05 ? "高胜率+低期望=赢小亏大" :
         not na(expectR) and expectR <= 0 ? "期望为负" : "—"
    table.cell(t, 0, 8, "提示")
    table.cell(t, 1, 8, warn, text_color = warn == "—" ? color.gray : color.orange)
    table.cell(t, 0, 9, "未扣成本", text_color = color.gray)
    table.cell(t, 1, 9, "手续费 + 资金费率", text_color = color.gray)
    table.cell(t, 0, 10, "这是校准，不是回测", text_color = color.gray)
    table.cell(t, 1, 10, "", text_color = color.gray)

// ───────────────────────────────────────────────────────── 10. 警报

alertcondition(isNewLong,     "主信号：做多",   "LC 主信号 做多")
alertcondition(isNewShort,    "主信号：做空",   "LC 主信号 做空")
alertcondition(pullbackLong,  "首次回调：多",   "LC 首次回调 多")
alertcondition(pullbackShort, "首次回调：空",   "LC 首次回调 空")
alertcondition(revUpReg,      "均值回归：向上", "LC 均值回归 向上")
alertcondition(revDnReg,      "均值回归：向下", "LC 均值回归 向下")
alertcondition(revUpStr,      "强均值回归：向上", "LC 强均值回归 向上")
alertcondition(revDnStr,      "强均值回归：向下", "LC 强均值回归 向下")
